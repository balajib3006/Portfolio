@model List<BalajiPortfolio.Models.DTO.ProjectDTO>
@{
    ViewData["Title"] = "Projects & Portfolio";
}

<style>
    .project-card {
        border: none;
        border-radius: 16px;
        box-shadow: 0 8px 26px rgba(0,0,0,0.06);
        background: #ffffff;
        transition: transform 0.2s ease, box-shadow 0.2s ease;
        overflow: hidden;
    }
    .project-card:hover {
        box-shadow: 0 14px 34px rgba(0,0,0,0.12);
        transform: translateY(-2px);
    }
    .project-img-container {
        height: 200px;
        background: #f1f5f9;
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
        position: relative;
    }
    .project-img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }
    .project-img-placeholder {
        color: #94a3b8;
        font-size: 3rem;
    }
    .tag-badge {
        background: #e0e7ff;
        color: #3730a3;
        font-weight: 600;
        font-size: 0.8rem;
        padding: 4px 10px;
        border-radius: 6px;
    }
    .cad-badge {
        background: #fef3c7;
        color: #92400e;
        font-weight: 600;
        font-size: 0.825rem;
        padding: 6px 12px;
        border-radius: 8px;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 6px;
    }
    .cad-badge:hover {
        background: #fde68a;
        color: #78350f;
    }
</style>

<div class="container-fluid px-0">

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-3 mb-4 shadow-sm" role="alert">
            <i class="fa-solid fa-circle-check me-2"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show rounded-3 mb-4 shadow-sm" role="alert">
            <i class="fa-solid fa-circle-exclamation me-2"></i> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Header Section -->
    <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
        <div>
            <h2 class="h3 fw-bold text-dark mb-1"><i class="fa-solid fa-diagram-project text-primary me-2"></i>Projects Showcase</h2>
            <p class="text-muted mb-0">Manage your CAD designs, product images, technical descriptions, and project tags</p>
        </div>
        <button type="button" class="btn btn-primary btn-lg rounded-3 shadow-sm px-4 fw-semibold" onclick="openAddProjectModal()">
            <i class="fa-solid fa-plus me-2"></i>Add Project
        </button>
    </div>

    <!-- Projects Grid -->
    @if (Model != null && Model.Count > 0)
    {
        <div class="row g-4">
            @foreach (var item in Model)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="card project-card h-100">
                        <div class="project-img-container">
                            @if (!string.IsNullOrEmpty(item.productImageUrl))
                            {
                                <img src="@item.productImageUrl" alt="Product Image" class="project-img" />
                            }
                            else
                            {
                                <div class="project-img-placeholder">
                                    <i class="fa-solid fa-cube"></i>
                                </div>
                            }
                        </div>
                        <div class="card-body p-4 d-flex flex-direction-column justify-content-between">
                            <div>
                                <h4 class="fw-bold text-dark mb-2">@item.projectTitle</h4>
                                <p class="text-muted small mb-3" style="white-space: pre-line;">@item.description</p>

                                @if (!string.IsNullOrEmpty(item.cadFilePath))
                                {
                                    <div class="mb-3">
                                        <a href="@item.cadFilePath" download class="cad-badge">
                                            <i class="fa-solid fa-file-export"></i> CAD File (@System.IO.Path.GetExtension(item.cadFilePath).ToUpper())
                                        </a>
                                    </div>
                                }

                                @if (item.tagsList != null && item.tagsList.Count > 0)
                                {
                                    <div class="d-flex flex-wrap gap-2 mb-3">
                                        @foreach (var tag in item.tagsList)
                                        {
                                            <span class="tag-badge"><i class="fa-solid fa-tag me-1"></i>@tag</span>
                                        }
                                    </div>
                                }
                            </div>

                            <div class="d-flex justify-content-end gap-2 pt-3 border-top mt-auto">
                                <button type="button" class="btn btn-outline-primary btn-sm rounded-2" onclick='editProject(@Html.Raw(System.Text.Json.JsonSerializer.Serialize(item)))'>
                                    <i class="fa-solid fa-pen me-1"></i>Edit
                                </button>
                                <form asp-controller="Project" asp-action="DeleteProject" method="post" class="d-inline" onsubmit="return confirm('Are you sure you want to delete this project?');">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@item.mstProjectId" />
                                    <button type="submit" class="btn btn-outline-danger btn-sm rounded-2">
                                        <i class="fa-solid fa-trash me-1"></i>Delete
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="card project-card p-5 text-center my-4">
            <i class="fa-solid fa-diagram-project text-muted fs-1 mb-3"></i>
            <h5 class="fw-bold text-dark">No Projects Added Yet</h5>
            <p class="text-muted mb-4">Click the <strong>"Add Project"</strong> button above to add your CAD designs and portfolio projects.</p>
            <div>
                <button type="button" class="btn btn-primary rounded-3 px-4 fw-semibold" onclick="openAddProjectModal()">
                    <i class="fa-solid fa-plus me-2"></i>Add Project
                </button>
            </div>
        </div>
    }

</div>

<!-- ================================================================= -->
<!-- MODAL: Add / Edit Project Form -->
<!-- ================================================================= -->
<div class="modal fade" id="modalProject" tabindex="-1" aria-labelledby="modalProjectLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content border-0 shadow-lg rounded-4">
            <div class="modal-header bg-primary text-white rounded-top-4">
                <h5 class="modal-title fw-bold" id="modalProjectLabel">
                    <i class="fa-solid fa-cube me-2"></i><span id="modalProjectTitleText">Add Project</span>
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-controller="Project" asp-action="SaveProject" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <input type="hidden" name="mstProjectId" id="projId" value="0" />
                <input type="hidden" name="productImageUrl" id="projImageUrl" value="" />
                <input type="hidden" name="cadFilePath" id="projCadFilePath" value="" />

                <div class="modal-body p-4">
                    <div class="row g-3">
                        <div class="col-12">
                            <label class="form-label fw-semibold">Project Title <span class="text-danger">*</span></label>
                            <input type="text" name="projectTitle" id="projTitle" class="form-control" placeholder="Enter project title" required />
                        </div>

                        <div class="col-12">
                            <label class="form-label fw-semibold">Description</label>
                            <textarea name="description" id="projDescription" class="form-control" rows="3" placeholder="Provide project overview, materials used, specs, etc."></textarea>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Product Image</label>
                            <input type="file" name="productImageFile" class="form-control" accept="image/*" />
                            <small class="text-muted">Upload product rendered image (PNG, JPG, WebP)</small>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-semibold">CAD File (.step, .stp, .iges)</label>
                            <input type="file" name="cadFile" class="form-control" accept=".step,.stp,.iges" />
                            <small class="text-muted">Allowed formats: <strong>.step</strong>, <strong>.stp</strong>, <strong>.iges</strong></small>
                        </div>

                        <!-- TAGS SECTION WITH DYNAMIC ADD BUTTON -->
                        <div class="col-12 mt-4">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <label class="form-label fw-bold text-dark mb-0">
                                    <i class="fa-solid fa-tags me-2 text-primary"></i>Project Tags
                                </label>
                                <!-- NEAR TAGS FIELD KEEP ADD BUTTON -->
                                <button type="button" class="btn btn-outline-primary btn-sm rounded-pill fw-semibold px-3" onclick="addTagField()">
                                    <i class="fa-solid fa-plus me-1"></i>Add Tag
                                </button>
                            </div>
                            <small class="text-muted d-block mb-3">Add tags to categorize your project (e.g., SolidWorks, Mechanical, 3D Print, Enclosure).</small>

                            <!-- Dynamic Tags Input Container -->
                            <div id="tagsContainer"></div>
                        </div>
                    </div>
                </div>

                <div class="modal-footer bg-light rounded-bottom-4">
                    <button type="button" class="btn btn-secondary px-4" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary px-4 fw-semibold">Save Project</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let modalProject;

        document.addEventListener('DOMContentLoaded', function () {
            modalProject = new bootstrap.Modal(document.getElementById('modalProject'));
        });

        function openAddProjectModal() {
            document.getElementById('modalProjectTitleText').innerText = "Add Project";
            document.getElementById('projId').value = 0;
            document.getElementById('projTitle').value = "";
            document.getElementById('projDescription').value = "";
            document.getElementById('projImageUrl').value = "";
            document.getElementById('projCadFilePath').value = "";

            // Clear tags container and add one initial blank tag input
            const container = document.getElementById('tagsContainer');
            container.innerHTML = "";
            addTagField();

            modalProject.show();
        }

        function addTagField(value = '') {
            const container = document.getElementById('tagsContainer');
            const div = document.createElement('div');
            div.className = 'input-group mb-2 tag-row';
            div.innerHTML = `
                <span class="input-group-text bg-light text-primary"><i class="fa-solid fa-tag"></i></span>
                <input type="text" name="tagsList" class="form-control" placeholder="Enter tag name..." value="${escapeHtml(value)}" required />
                <button type="button" class="btn btn-outline-danger" onclick="this.closest('.tag-row').remove()" title="Remove Tag">
                    <i class="fa-solid fa-trash-can"></i>
                </button>
            `;
            container.appendChild(div);
        }

        function editProject(data) {
            document.getElementById('modalProjectTitleText').innerText = "Edit Project";
            document.getElementById('projId').value = data.mstProjectId;
            document.getElementById('projTitle').value = data.projectTitle || "";
            document.getElementById('projDescription').value = data.description || "";
            document.getElementById('projImageUrl').value = data.productImageUrl || "";
            document.getElementById('projCadFilePath').value = data.cadFilePath || "";

            const container = document.getElementById('tagsContainer');
            container.innerHTML = "";

            if (data.tagsList && data.tagsList.length > 0) {
                data.tagsList.forEach(function (tag) {
                    addTagField(tag);
                });
            } else {
                addTagField();
            }

            modalProject.show();
        }

        function escapeHtml(str) {
            if (!str) return '';
            return str.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;").replace(/'/g, "&#039;");
        }
    </script>
}
