@{
    ViewData["Title"] = "Projects & Portfolio";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="h4 fw-bold text-dark mb-1"><i class="fa-solid fa-diagram-project text-info me-2"></i>Projects Portfolio</h2>
        <p class="text-muted mb-0">Manage your featured projects, screenshots, tech stacks, and live demo links</p>
    </div>
    <button class="btn btn-info text-white rounded-3 px-4 fw-semibold">
        <i class="fa-solid fa-plus me-2"></i>Add Project
    </button>
</div>

<div class="card border-0 shadow-sm rounded-4">
    <div class="card-body p-4 text-center py-5">
        <i class="fa-solid fa-folder-open text-muted fs-1 mb-3"></i>
        <h5 class="fw-bold text-dark">No Projects Added Yet</h5>
        <p class="text-muted mb-3">Click the "Add Project" button above to add your showcase projects.</p>
    </div>
</div>
