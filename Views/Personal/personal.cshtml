@model BalajiPortfolio.Models.DTO.PersonalDTO
@{
    ViewData["Title"] = "Personal Profile & Details";
    bool hasPersonal = !string.IsNullOrEmpty(Model.name);
    bool hasAbout = !string.IsNullOrEmpty(Model.professionalSummary) || !string.IsNullOrEmpty(Model.yearsOfExperience);
    bool hasSocial = !string.IsNullOrEmpty(Model.linkedInUrl) || !string.IsNullOrEmpty(Model.gitHubUrl);
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

<style>
    .portfolio-card {
        border: none;
        border-radius: 16px;
        box-shadow: 0 8px 26px rgba(0,0,0,0.06);
        transition: transform 0.2s ease, box-shadow 0.2s ease;
        background: #ffffff;
    }
    .portfolio-card:hover {
        box-shadow: 0 12px 32px rgba(0,0,0,0.1);
    }
    .profile-avatar {
        width: 140px;
        height: 140px;
        object-fit: cover;
        border-radius: 50%;
        border: 4px solid #2563eb;
        box-shadow: 0 8px 20px rgba(37, 99, 235, 0.2);
    }
    .profile-avatar-placeholder {
        width: 140px;
        height: 140px;
        border-radius: 50%;
        background: linear-gradient(135deg, #3b82f6 0%, #2563eb 100%);
        color: white;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 3rem;
        font-weight: bold;
        border: 4px solid #2563eb;
        box-shadow: 0 8px 20px rgba(37, 99, 235, 0.2);
    }
    .stat-badge {
        background: #eff6ff;
        border-radius: 12px;
        padding: 16px 20px;
        text-align: center;
        border-left: 4px solid #2563eb;
    }
    .stat-number {
        font-size: 1.5rem;
        font-weight: 700;
        color: #1e40af;
    }
    .stat-label {
        font-size: 0.85rem;
        color: #3b82f6;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        font-weight: 600;
    }
    .btn-blue {
        background: linear-gradient(135deg, #2563eb 0%, #3b82f6 100%);
        color: white;
        border: none;
        padding: 10px 22px;
        border-radius: 10px;
        font-weight: 600;
        box-shadow: 0 4px 12px rgba(37, 99, 235, 0.3);
        transition: all 0.2s ease;
    }
    .btn-blue:hover {
        background: linear-gradient(135deg, #1d4ed8 0%, #2563eb 100%);
        color: white;
        transform: translateY(-1px);
    }
    .social-btn {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        padding: 10px 18px;
        border-radius: 10px;
        font-weight: 600;
        text-decoration: none;
        background: #eff6ff;
        color: #1e40af;
        border: 1px solid #bfdbfe;
        transition: all 0.2s ease;
    }
    .social-btn:hover {
        background: #2563eb;
        color: white;
        border-color: #2563eb;
        transform: translateY(-2px);
    }

    /* Custom Horizontal Tab Navigation Bar Styling (Unified Blue Theme) */
    .nav-tabs-custom {
        border-bottom: 1px solid #e2e8f0;
        display: flex;
        gap: 32px;
        margin-bottom: 28px;
        padding-left: 4px;
    }
    .nav-tabs-custom .nav-link {
        border: none;
        background: transparent;
        color: #64748b;
        font-weight: 600;
        font-size: 1.05rem;
        padding: 12px 4px;
        position: relative;
        cursor: pointer;
        transition: all 0.2s ease;
    }
    .nav-tabs-custom .nav-link:hover {
        color: #2563eb;
    }
    .nav-tabs-custom .nav-link.active {
        color: #2563eb;
        background: transparent;
        font-weight: 700;
    }
    .nav-tabs-custom .nav-link.active::after {
        content: '';
        position: absolute;
        bottom: -1px;
        left: 0;
        width: 100%;
        height: 3px;
        background-color: #2563eb;
        border-radius: 3px 3px 0 0;
    }
</style>

<div class="container-fluid px-0">

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-3 mb-4 shadow-sm" role="alert">
            <i class="fa-solid fa-circle-check me-2"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show rounded-3 mb-4 shadow-sm" role="alert">
            <i class="fa-solid fa-circle-exclamation me-2"></i> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- HORIZONTAL TAB NAVIGATION BAR (UNIFIED BLUE THEME) -->
    <ul class="nav nav-tabs-custom" id="personalTabs" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active" id="personal-details-tab" data-bs-toggle="tab" data-bs-target="#tabPersonalDetails" type="button" role="tab" aria-controls="tabPersonalDetails" aria-selected="true">
                <i class="fa-solid fa-user me-2"></i>Personal Details
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="about-section-tab" data-bs-toggle="tab" data-bs-target="#tabAboutSection" type="button" role="tab" aria-controls="tabAboutSection" aria-selected="false">
                <i class="fa-solid fa-address-card me-2"></i>About Section
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="social-media-tab" data-bs-toggle="tab" data-bs-target="#tabSocialMedia" type="button" role="tab" aria-controls="tabSocialMedia" aria-selected="false">
                <i class="fa-solid fa-share-nodes me-2"></i>Social Media Links
            </button>
        </li>
    </ul>

    <!-- TAB PANELS CONTENT -->
    <div class="tab-content" id="personalTabsContent">

        <!-- TAB 1: PERSONAL DETAILS -->
        <div class="tab-pane fade show active" id="tabPersonalDetails" role="tabpanel" aria-labelledby="personal-details-tab">
            <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
                <div>
                    <h3 class="h4 fw-bold text-dark mb-1"><i class="fa-solid fa-id-card text-primary me-2"></i>Personal Information</h3>
                    <p class="text-muted mb-0">Manage your name, profile picture, contact info, location, and bio</p>
                </div>
                <button type="button" class="btn btn-blue" data-bs-toggle="modal" data-bs-target="#modalPersonalDetails">
                    <i class="fa-solid fa-user-plus me-2"></i>@(hasPersonal ? "Edit Details" : "Add details")
                </button>
            </div>

            <div class="card portfolio-card p-4">
                <div class="row align-items-center">
                    <div class="col-md-3 text-center mb-3 mb-md-0">
                        @if (!string.IsNullOrEmpty(Model.profilePictureUrl))
                        {
                            <img src="@Model.profilePictureUrl" alt="Profile Picture" class="profile-avatar mb-2" />
                        }
                        else
                        {
                            <div class="profile-avatar-placeholder mx-auto mb-2">
                                @(string.IsNullOrEmpty(Model.name) ? "P" : Model.name.Substring(0, 1).ToUpper())
                            </div>
                        }
                    </div>
                    <div class="col-md-9">
                        <h2 class="fw-bold text-dark mb-1">
                            @(string.IsNullOrEmpty(Model.name) ? "Your Name Here" : Model.name)
                        </h2>
                        @if (!string.IsNullOrEmpty(Model.workDetails))
                        {
                            <p class="text-primary fw-semibold fs-5 mb-2">
                                <i class="fa-solid fa-briefcase me-2"></i>@Model.workDetails
                            </p>
                        }

                        <div class="d-flex flex-wrap gap-3 my-3">
                            @if (!string.IsNullOrEmpty(Model.email))
                            {
                                <span class="badge bg-light text-primary fs-6 p-2 border border-primary-subtle">
                                    <i class="fa-solid fa-envelope text-primary me-2"></i>@Model.email
                                </span>
                            }
                            @if (!string.IsNullOrEmpty(Model.mobileNumber))
                            {
                                <span class="badge bg-light text-primary fs-6 p-2 border border-primary-subtle">
                                    <i class="fa-solid fa-phone text-primary me-2"></i>@Model.mobileNumber
                                </span>
                            }
                            @if (!string.IsNullOrEmpty(Model.location))
                            {
                                <span class="badge bg-light text-primary fs-6 p-2 border border-primary-subtle">
                                    <i class="fa-solid fa-location-dot text-primary me-2"></i>@Model.location
                                </span>
                            }
                        </div>

                        @if (!string.IsNullOrEmpty(Model.bio))
                        {
                            <div class="mt-3 p-3 bg-light rounded-3 border-start border-4 border-primary">
                                <h6 class="fw-bold text-primary mb-1"><i class="fa-solid fa-quote-left me-2"></i>Bio</h6>
                                <p class="mb-0 text-dark">@Model.bio</p>
                            </div>
                        }
                        else if (!hasPersonal)
                        {
                            <p class="text-muted italic mb-0">No personal details added yet. Click <strong>"Add details"</strong> at the top right to populate your profile.</p>
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- TAB 2: ABOUT SECTION -->
        <div class="tab-pane fade" id="tabAboutSection" role="tabpanel" aria-labelledby="about-section-tab">
            <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
                <div>
                    <h3 class="h4 fw-bold text-dark mb-1"><i class="fa-solid fa-user-tie text-primary me-2"></i>About Section</h3>
                    <p class="text-muted mb-0">Manage professional summary, years of experience, completed projects, and companies worked</p>
                </div>
                <button type="button" class="btn btn-blue" data-bs-toggle="modal" data-bs-target="#modalAboutSection">
                    <i class="fa-solid fa-file-pen me-2"></i>@(hasAbout ? "Edit About section" : "Add About section")
                </button>
            </div>

            <div class="card portfolio-card p-4">
                <div class="row g-3 mb-4">
                    <div class="col-md-4">
                        <div class="stat-badge">
                            <div class="stat-number">@(string.IsNullOrEmpty(Model.yearsOfExperience) ? "0" : Model.yearsOfExperience)</div>
                            <div class="stat-label"><i class="fa-solid fa-clock me-1"></i>Years of Experience</div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="stat-badge">
                            <div class="stat-number">@(string.IsNullOrEmpty(Model.projectsCompleted) ? "0" : Model.projectsCompleted)</div>
                            <div class="stat-label"><i class="fa-solid fa-list-check me-1"></i>Projects Completed</div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="stat-badge">
                            <div class="stat-number">@(string.IsNullOrEmpty(Model.companiesWorked) ? "0" : Model.companiesWorked)</div>
                            <div class="stat-label"><i class="fa-solid fa-building me-1"></i>Companies Worked</div>
                        </div>
                    </div>
                </div>

                @if (!string.IsNullOrEmpty(Model.professionalSummary))
                {
                    <div class="p-3 bg-light rounded-3 border-start border-4 border-primary">
                        <h6 class="fw-bold text-primary mb-2"><i class="fa-solid fa-align-left me-2"></i>Professional Summary</h6>
                        <p class="mb-0 text-dark" style="white-space: pre-line;">@Model.professionalSummary</p>
                    </div>
                }
                else
                {
                    <p class="text-muted mb-0">No professional summary added yet. Click <strong>"Add About section"</strong> above to add details.</p>
                }
            </div>
        </div>

        <!-- TAB 3: SOCIAL MEDIA LINKS -->
        <div class="tab-pane fade" id="tabSocialMedia" role="tabpanel" aria-labelledby="social-media-tab">
            <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
                <div>
                    <h3 class="h4 fw-bold text-dark mb-1"><i class="fa-solid fa-share-nodes text-primary me-2"></i>Social Media Profiles</h3>
                    <p class="text-muted mb-0">Link your LinkedIn, GitHub, GitLab, ORCID, and Google Scholar accounts</p>
                </div>
                <button type="button" class="btn btn-blue" data-bs-toggle="modal" data-bs-target="#modalSocialMedia">
                    <i class="fa-solid fa-link me-2"></i>@(hasSocial ? "Edit Social media" : "Add social media")
                </button>
            </div>

            <div class="card portfolio-card p-4">
                <div class="d-flex flex-wrap gap-3">
                    @if (!string.IsNullOrEmpty(Model.linkedInUrl))
                    {
                        <a href="@Model.linkedInUrl" target="_blank" class="social-btn">
                            <i class="fa-brands fa-linkedin fs-5"></i> LinkedIn
                        </a>
                    }
                    @if (!string.IsNullOrEmpty(Model.gitHubUrl))
                    {
                        <a href="@Model.gitHubUrl" target="_blank" class="social-btn">
                            <i class="fa-brands fa-github fs-5"></i> GitHub
                        </a>
                    }
                    @if (!string.IsNullOrEmpty(Model.gitLabUrl))
                    {
                        <a href="@Model.gitLabUrl" target="_blank" class="social-btn">
                            <i class="fa-brands fa-gitlab fs-5"></i> GitLab
                        </a>
                    }
                    @if (!string.IsNullOrEmpty(Model.orcidUrl))
                    {
                        <a href="@Model.orcidUrl" target="_blank" class="social-btn">
                            <i class="fa-brands fa-orcid fs-5"></i> ORCID
                        </a>
                    }
                    @if (!string.IsNullOrEmpty(Model.googleScholarUrl))
                    {
                        <a href="@Model.googleScholarUrl" target="_blank" class="social-btn">
                            <i class="fa-solid fa-graduation-cap fs-5"></i> Google Scholar
                        </a>
                    }

                    @if (!hasSocial)
                    {
                        <p class="text-muted mb-0">No social media profiles added yet. Click <strong>"Add social media"</strong> above to link your accounts.</p>
                    }
                </div>
            </div>
        </div>

    </div>

</div>

<!-- ================================================================= -->
<!-- MODAL 1: Personal Details Form -->
<!-- ================================================================= -->
<div class="modal fade" id="modalPersonalDetails" tabindex="-1" aria-labelledby="modalPersonalDetailsLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content border-0 shadow-lg rounded-4">
            <div class="modal-header bg-primary text-white rounded-top-4">
                <h5 class="modal-title fw-bold" id="modalPersonalDetailsLabel">
                    <i class="fa-solid fa-user-gear me-2"></i>Personal Details
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-controller="Personal" asp-action="SaveDetails" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <input type="hidden" name="mstPersonalId" value="@Model.mstPersonalId" />
                <input type="hidden" name="profilePictureUrl" value="@Model.profilePictureUrl" />
                
                <div class="modal-body p-4">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Full Name <span class="text-danger">*</span></label>
                            <input type="text" name="name" class="form-control" value="@Model.name" placeholder="Enter your full name" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Profile Picture</label>
                            <input type="file" name="profilePictureFile" class="form-control" accept="image/*" />
                            <small class="text-muted">Upload PNG, JPG, or JPEG image</small>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Mobile Number</label>
                            <input type="tel" name="mobileNumber" class="form-control" value="@Model.mobileNumber" placeholder="+1 234 567 8900" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Email ID</label>
                            <input type="email" name="email" class="form-control" value="@Model.email" placeholder="your.email@example.com" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Location</label>
                            <input type="text" name="location" class="form-control" value="@Model.location" placeholder="City, Country" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Work Details (Role / Designation)</label>
                            <input type="text" name="workDetails" class="form-control" value="@Model.workDetails" placeholder="e.g. Senior Software Engineer" />
                        </div>
                        <div class="col-12">
                            <label class="form-label fw-semibold">Bio</label>
                            <textarea name="bio" class="form-control" rows="3" placeholder="Tell us a little bit about yourself...">@Model.bio</textarea>
                        </div>
                    </div>
                </div>
                <div class="modal-footer bg-light rounded-bottom-4">
                    <button type="button" class="btn btn-secondary px-4" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary px-4 fw-semibold">Save Details</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- ================================================================= -->
<!-- MODAL 2: About Section Form -->
<!-- ================================================================= -->
<div class="modal fade" id="modalAboutSection" tabindex="-1" aria-labelledby="modalAboutSectionLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content border-0 shadow-lg rounded-4">
            <div class="modal-header bg-primary text-white rounded-top-4">
                <h5 class="modal-title fw-bold" id="modalAboutSectionLabel">
                    <i class="fa-solid fa-address-card me-2"></i>About Section
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-controller="Personal" asp-action="SaveAbout" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="mstPersonalId" value="@Model.mstPersonalId" />

                <div class="modal-body p-4">
                    <div class="row g-3">
                        <div class="col-12">
                            <label class="form-label fw-semibold">Professional Summary</label>
                            <textarea name="professionalSummary" class="form-control" rows="4" placeholder="Write a summary of your experience, key achievements, and skills...">@Model.professionalSummary</textarea>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-semibold">Years of Experience</label>
                            <input type="text" name="yearsOfExperience" class="form-control" value="@Model.yearsOfExperience" placeholder="e.g. 5+ Years" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-semibold">Projects Completed</label>
                            <input type="text" name="projectsCompleted" class="form-control" value="@Model.projectsCompleted" placeholder="e.g. 25+" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-semibold">Companies Worked</label>
                            <input type="text" name="companiesWorked" class="form-control" value="@Model.companiesWorked" placeholder="e.g. 4" />
                        </div>
                    </div>
                </div>
                <div class="modal-footer bg-light rounded-bottom-4">
                    <button type="button" class="btn btn-secondary px-4" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary px-4 fw-semibold">Save About Section</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- ================================================================= -->
<!-- MODAL 3: Social Media Links Form -->
<!-- ================================================================= -->
<div class="modal fade" id="modalSocialMedia" tabindex="-1" aria-labelledby="modalSocialMediaLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content border-0 shadow-lg rounded-4">
            <div class="modal-header bg-primary text-white rounded-top-4">
                <h5 class="modal-title fw-bold" id="modalSocialMediaLabel">
                    <i class="fa-solid fa-hashtag me-2"></i>Social Media Links
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-controller="Personal" asp-action="SaveSocialMedia" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="mstPersonalId" value="@Model.mstPersonalId" />

                <div class="modal-body p-4">
                    <div class="row g-3">
                        <div class="col-12">
                            <label class="form-label fw-semibold"><i class="fa-brands fa-linkedin text-primary me-2"></i>LinkedIn URL</label>
                            <input type="url" name="linkedInUrl" class="form-control" value="@Model.linkedInUrl" placeholder="https://linkedin.com/in/username" />
                        </div>
                        <div class="col-12">
                            <label class="form-label fw-semibold"><i class="fa-brands fa-github text-primary me-2"></i>GitHub URL</label>
                            <input type="url" name="gitHubUrl" class="form-control" value="@Model.gitHubUrl" placeholder="https://github.com/username" />
                        </div>
                        <div class="col-12">
                            <label class="form-label fw-semibold"><i class="fa-brands fa-gitlab text-primary me-2"></i>GitLab URL</label>
                            <input type="url" name="gitLabUrl" class="form-control" value="@Model.gitLabUrl" placeholder="https://gitlab.com/username" />
                        </div>
                        <div class="col-12">
                            <label class="form-label fw-semibold"><i class="fa-brands fa-orcid text-primary me-2"></i>ORCID URL</label>
                            <input type="url" name="orcidUrl" class="form-control" value="@Model.orcidUrl" placeholder="https://orcid.org/0000-0000-0000-0000" />
                        </div>
                        <div class="col-12">
                            <label class="form-label fw-semibold"><i class="fa-solid fa-graduation-cap text-primary me-2"></i>Google Scholar URL</label>
                            <input type="url" name="googleScholarUrl" class="form-control" value="@Model.googleScholarUrl" placeholder="https://scholar.google.com/citations?user=..." />
                        </div>
                    </div>
                </div>
                <div class="modal-footer bg-light rounded-bottom-4">
                    <button type="button" class="btn btn-secondary px-4" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary px-4 fw-semibold">Save Social Media</button>
                </div>
            </form>
        </div>
    </div>
</div>
