@model List<BalajiPortfolio.Models.DTO.CertificationDTO>
@{
    ViewData["Title"] = "Certifications & Badges";
}

<style>
    .cert-card {
        border: none;
        border-radius: 16px;
        box-shadow: 0 8px 26px rgba(0,0,0,0.06);
        background: #ffffff;
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }
    .cert-card:hover {
        box-shadow: 0 14px 34px rgba(0,0,0,0.12);
        transform: translateY(-2px);
    }
    .type-badge-cert {
        background: #fef3c7;
        color: #92400e;
        font-weight: 600;
        font-size: 0.8rem;
        padding: 4px 12px;
        border-radius: 8px;
    }
    .type-badge-badge {
        background: #e0e7ff;
        color: #3730a3;
        font-weight: 600;
        font-size: 0.8rem;
        padding: 4px 12px;
        border-radius: 8px;
    }
    .cert-icon {
        width: 50px;
        height: 50px;
        border-radius: 12px;
        background: rgba(79, 70, 229, 0.1);
        color: #4f46e5;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.5rem;
    }
    .badge-icon {
        width: 50px;
        height: 50px;
        border-radius: 12px;
        background: rgba(245, 158, 11, 0.1);
        color: #d97706;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.5rem;
    }
</style>

<div class="container-fluid px-0">

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-3 mb-4 shadow-sm" role="alert">
            <i class="fa-solid fa-circle-check me-2"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show rounded-3 mb-4 shadow-sm" role="alert">
            <i class="fa-solid fa-circle-exclamation me-2"></i> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Header Section -->
    <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
        <div>
            <h2 class="h3 fw-bold text-dark mb-1"><i class="fa-solid fa-certificate text-warning me-2"></i>Certifications & Badges</h2>
            <p class="text-muted mb-0">Manage professional certificates, achievement badges, verification links, and embed codes</p>
        </div>
        <button type="button" class="btn btn-warning text-dark btn-lg rounded-3 shadow-sm px-4 fw-semibold" onclick="openAddCertificationModal()">
            <i class="fa-solid fa-plus me-2"></i>Add Certification / Badge
        </button>
    </div>

    <!-- Certifications & Badges Cards Grid -->
    @if (Model != null && Model.Count > 0)
    {
        <div class="row g-4">
            @foreach (var item in Model)
            {
                bool isBadge = (item.type == "Badge");
                <div class="col-md-6 col-lg-4">
                    <div class="card cert-card h-100 p-4 d-flex flex-column justify-content-between">
                        <div>
                            <div class="d-flex justify-content-between align-items-start mb-3">
                                <div class="@(isBadge ? "badge-icon" : "cert-icon")">
                                    <i class="fa-solid @(isBadge ? "fa-award" : "fa-certificate")"></i>
                                </div>
                                <span class="@(isBadge ? "type-badge-badge" : "type-badge-cert")">
                                    <i class="fa-solid @(isBadge ? "fa-shield-halved" : "fa-ribbon") me-1"></i>@item.type
                                </span>
                            </div>

                            <h5 class="fw-bold text-dark mb-1">@item.name</h5>

                            @if (!string.IsNullOrEmpty(item.issuer))
                            {
                                <p class="text-primary fw-semibold small mb-2"><i class="fa-solid fa-building me-1"></i>@item.issuer</p>
                            }

                            @if (!string.IsNullOrEmpty(item.issueDate))
                            {
                                <p class="text-muted small mb-3"><i class="fa-regular fa-calendar-check me-1"></i>Issued: @item.issueDate</p>
                            }

                            @if (!string.IsNullOrEmpty(item.credentialLink))
                            {
                                <div class="mb-3">
                                    <a href="@item.credentialLink" target="_blank" class="btn btn-sm btn-outline-secondary rounded-2">
                                        <i class="fa-solid fa-arrow-up-right-from-square me-1"></i>Verify Credential
                                    </a>
                                </div>
                            }

                            @if (!string.IsNullOrEmpty(item.embedCode))
                            {
                                <div class="mt-2 p-2 bg-light rounded-3 border small">
                                    <div class="fw-semibold text-secondary mb-1"><i class="fa-solid fa-code me-1"></i>Embed Code Snippet</div>
                                    <code class="text-dark d-block text-truncate" style="max-height: 40px;">@item.embedCode</code>
                                </div>
                            }
                        </div>

                        <div class="d-flex justify-content-end gap-2 pt-3 border-top mt-3">
                            <button type="button" class="btn btn-outline-primary btn-sm rounded-2" onclick='editCertification(@Html.Raw(System.Text.Json.JsonSerializer.Serialize(item)))'>
                                <i class="fa-solid fa-pen me-1"></i>Edit
                            </button>
                            <form asp-controller="Certification" asp-action="DeleteCertification" method="post" class="d-inline" onsubmit="return confirm('Are you sure you want to delete this record?');">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@item.mstCertificationId" />
                                <button type="submit" class="btn btn-outline-danger btn-sm rounded-2">
                                    <i class="fa-solid fa-trash me-1"></i>Delete
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="card cert-card p-5 text-center my-4">
            <i class="fa-solid fa-award text-muted fs-1 mb-3"></i>
            <h5 class="fw-bold text-dark">No Certifications or Badges Added Yet</h5>
            <p class="text-muted mb-4">Click the <strong>"Add Certification / Badge"</strong> button above to populate your credentials.</p>
            <div>
                <button type="button" class="btn btn-warning text-dark rounded-3 px-4 fw-semibold" onclick="openAddCertificationModal()">
                    <i class="fa-solid fa-plus me-2"></i>Add Certification / Badge
                </button>
            </div>
        </div>
    }

</div>

<!-- ================================================================= -->
<!-- MODAL: Add / Edit Certification or Badge Form -->
<!-- ================================================================= -->
<div class="modal fade" id="modalCertification" tabindex="-1" aria-labelledby="modalCertificationLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content border-0 shadow-lg rounded-4">
            <div class="modal-header bg-warning text-dark rounded-top-4">
                <h5 class="modal-title fw-bold" id="modalCertificationLabel">
                    <i class="fa-solid fa-certificate me-2"></i><span id="modalCertTitleText">Add Certification / Badge</span>
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-controller="Certification" asp-action="SaveCertification" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="mstCertificationId" id="certId" value="0" />

                <div class="modal-body p-4">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Type <span class="text-danger">*</span></label>
                            <select name="type" id="certType" class="form-select" required>
                                <option value="Certification">Certification</option>
                                <option value="Badge">Badge</option>
                            </select>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Name <span class="text-danger">*</span></label>
                            <input type="text" name="name" id="certName" class="form-control" placeholder="e.g. AWS Certified Solutions Architect / Cloud Badge" required />
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Issuer</label>
                            <input type="text" name="issuer" id="certIssuer" class="form-control" placeholder="e.g. Amazon Web Services, Google, Microsoft" />
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Date / Year</label>
                            <input type="text" name="issueDate" id="certIssueDate" class="form-control" placeholder="e.g. 2024 / Jan 2024" />
                        </div>

                        <div class="col-12">
                            <label class="form-label fw-semibold">Credential Link (URL)</label>
                            <input type="url" name="credentialLink" id="certLink" class="form-control" placeholder="https://www.credly.com/badges/..." />
                        </div>

                        <div class="col-12">
                            <label class="form-label fw-semibold">Embed Code</label>
                            <textarea name="embedCode" id="certEmbedCode" class="form-control" rows="3" placeholder="Paste HTML/Script embed code snippet here..."></textarea>
                        </div>
                    </div>
                </div>

                <div class="modal-footer bg-light rounded-bottom-4">
                    <button type="button" class="btn btn-secondary px-4" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-warning text-dark px-4 fw-semibold">Save Credential</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let modalCertification;

        document.addEventListener('DOMContentLoaded', function () {
            modalCertification = new bootstrap.Modal(document.getElementById('modalCertification'));
        });

        function openAddCertificationModal() {
            document.getElementById('modalCertTitleText').innerText = "Add Certification / Badge";
            document.getElementById('certId').value = 0;
            document.getElementById('certType').value = "Certification";
            document.getElementById('certName').value = "";
            document.getElementById('certIssuer').value = "";
            document.getElementById('certIssueDate').value = "";
            document.getElementById('certLink').value = "";
            document.getElementById('certEmbedCode').value = "";

            modalCertification.show();
        }

        function editCertification(data) {
            document.getElementById('modalCertTitleText').innerText = "Edit Certification / Badge";
            document.getElementById('certId').value = data.mstCertificationId;
            document.getElementById('certType').value = data.type || "Certification";
            document.getElementById('certName').value = data.name || "";
            document.getElementById('certIssuer').value = data.issuer || "";
            document.getElementById('certIssueDate').value = data.issueDate || "";
            document.getElementById('certLink').value = data.credentialLink || "";
            document.getElementById('certEmbedCode').value = data.embedCode || "";

            modalCertification.show();
        }
    </script>
}
