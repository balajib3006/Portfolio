@{
    ViewData["Title"] = "Certifications";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="h4 fw-bold text-dark mb-1"><i class="fa-solid fa-certificate text-warning me-2"></i>Certifications</h2>
        <p class="text-muted mb-0">Manage professional certificates, issuing organizations, and credential URLs</p>
    </div>
    <button class="btn btn-warning text-dark rounded-3 px-4 fw-semibold">
        <i class="fa-solid fa-plus me-2"></i>Add Certification
    </button>
</div>

<div class="card border-0 shadow-sm rounded-4">
    <div class="card-body p-4 text-center py-5">
        <i class="fa-solid fa-award text-muted fs-1 mb-3"></i>
        <h5 class="fw-bold text-dark">No Certifications Added Yet</h5>
        <p class="text-muted mb-3">Click the "Add Certification" button above to add your professional credentials.</p>
    </div>
</div>
