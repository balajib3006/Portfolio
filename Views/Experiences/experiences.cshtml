@model List<BalajiPortfolio.Models.DTO.ExperienceDTO>
@{
    ViewData["Title"] = "Work Experience";
}

<style>
    .experience-card {
        border: none;
        border-radius: 16px;
        box-shadow: 0 8px 26px rgba(0,0,0,0.06);
        background: #ffffff;
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }
    .experience-card:hover {
        box-shadow: 0 12px 32px rgba(0,0,0,0.1);
    }
    .company-badge {
        background: #e0e7ff;
        color: #3730a3;
        font-weight: 600;
        padding: 6px 14px;
        border-radius: 8px;
    }
    .date-badge {
        background: #f1f5f9;
        color: #475569;
        font-weight: 500;
        padding: 6px 14px;
        border-radius: 8px;
    }
    .responsibility-bullet {
        margin-bottom: 8px;
        display: flex;
        align-items: flex-start;
        gap: 10px;
    }
    .responsibility-bullet i {
        color: #4f46e5;
        margin-top: 5px;
        font-size: 0.75rem;
    }
</style>

<div class="container-fluid px-0">

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-3 mb-4 shadow-sm" role="alert">
            <i class="fa-solid fa-circle-check me-2"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show rounded-3 mb-4 shadow-sm" role="alert">
            <i class="fa-solid fa-circle-exclamation me-2"></i> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Header Section -->
    <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
        <div>
            <h2 class="h3 fw-bold text-dark mb-1"><i class="fa-solid fa-briefcase text-primary me-2"></i>Work Experience</h2>
            <p class="text-muted mb-0">Manage your employment history, positions, and key responsibilities</p>
        </div>
        <button type="button" class="btn btn-primary btn-lg rounded-3 shadow-sm px-4 fw-semibold" onclick="openAddExperienceModal()">
            <i class="fa-solid fa-plus me-2"></i>Add Experience
        </button>
    </div>

    <!-- Experience List Cards -->
    @if (Model != null && Model.Count > 0)
    {
        <div class="row g-4">
            @foreach (var item in Model)
            {
                <div class="col-12">
                    <div class="card experience-card p-4">
                        <div class="d-flex justify-content-between align-items-start mb-3">
                            <div>
                                <h4 class="fw-bold text-dark mb-1">@item.jobTitle</h4>
                                <div class="d-flex flex-wrap align-items-center gap-2 mt-2">
                                    <span class="company-badge"><i class="fa-solid fa-building me-1"></i>@item.company</span>
                                    @if (!string.IsNullOrEmpty(item.location))
                                    {
                                        <span class="badge bg-light text-dark border p-2"><i class="fa-solid fa-location-dot me-1 text-danger"></i>@item.location</span>
                                    }
                                    <span class="date-badge">
                                        <i class="fa-regular fa-calendar-days me-1"></i>
                                        @item.startDate - @(item.isCurrentlyWorking ? "Present" : (string.IsNullOrEmpty(item.endDate) ? "N/A" : item.endDate))
                                    </span>
                                </div>
                            </div>
                            <div class="d-flex gap-2">
                                <button type="button" class="btn btn-outline-primary btn-sm rounded-2" onclick='editExperience(@Html.Raw(System.Text.Json.JsonSerializer.Serialize(item)))'>
                                    <i class="fa-solid fa-pen me-1"></i>Edit
                                </button>
                                <form asp-controller="Experience" asp-action="DeleteExperience" method="post" onsubmit="return confirm('Are you sure you want to delete this experience?');">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@item.mstExperienceId" />
                                    <button type="submit" class="btn btn-outline-danger btn-sm rounded-2">
                                        <i class="fa-solid fa-trash me-1"></i>Delete
                                    </button>
                                </form>
                            </div>
                        </div>

                        @if (item.responsibilitiesList != null && item.responsibilitiesList.Count > 0)
                        {
                            <div class="mt-3 pt-3 border-top">
                                <h6 class="fw-bold text-secondary mb-2"><i class="fa-solid fa-list-check me-2"></i>Key Responsibilities & Achievements:</h6>
                                <div class="ps-2">
                                    @foreach (var resp in item.responsibilitiesList)
                                    {
                                        <div class="responsibility-bullet">
                                            <i class="fa-solid fa-circle"></i>
                                            <span>@resp</span>
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="card experience-card p-5 text-center my-4">
            <i class="fa-solid fa-briefcase text-muted fs-1 mb-3"></i>
            <h5 class="fw-bold text-dark">No Experience Records Added Yet</h5>
            <p class="text-muted mb-4">Click the <strong>"Add Experience"</strong> button above to populate your career journey.</p>
            <div>
                <button type="button" class="btn btn-primary rounded-3 px-4 fw-semibold" onclick="openAddExperienceModal()">
                    <i class="fa-solid fa-plus me-2"></i>Add Experience
                </button>
            </div>
        </div>
    }

</div>

<!-- ================================================================= -->
<!-- MODAL: Add / Edit Experience Form -->
<!-- ================================================================= -->
<div class="modal fade" id="modalExperience" tabindex="-1" aria-labelledby="modalExperienceLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content border-0 shadow-lg rounded-4">
            <div class="modal-header bg-primary text-white rounded-top-4">
                <h5 class="modal-title fw-bold" id="modalExperienceLabel">
                    <i class="fa-solid fa-briefcase me-2"></i><span id="modalTitleText">Add Experience</span>
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-controller="Experience" asp-action="SaveExperience" method="post" id="formExperience">
                @Html.AntiForgeryToken()
                <input type="hidden" name="mstExperienceId" id="expId" value="0" />

                <div class="modal-body p-4">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Job Title <span class="text-danger">*</span></label>
                            <input type="text" name="jobTitle" id="expJobTitle" class="form-control" placeholder="e.g. Senior Software Engineer" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Company Name <span class="text-danger">*</span></label>
                            <input type="text" name="company" id="expCompany" class="form-control" placeholder="e.g. Google / Microsoft" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Location</label>
                            <input type="text" name="location" id="expLocation" class="form-control" placeholder="e.g. Bengaluru, India / Remote" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label fw-semibold">Start Date</label>
                            <input type="date" name="startDate" id="expStartDate" class="form-control" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label fw-semibold">End Date</label>
                            <input type="date" name="endDate" id="expEndDate" class="form-control" />
                        </div>
                        <div class="col-12">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" name="isCurrentlyWorking" value="true" id="expCurrentlyWorking" onchange="toggleEndDate(this)">
                                <label class="form-check-label fw-semibold" for="expCurrentlyWorking">
                                    I am currently working in this role
                                </label>
                            </div>
                        </div>

                        <!-- RESPONSIBILITIES SECTION WITH DYNAMIC ADD BUTTON -->
                        <div class="col-12 mt-4">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <label class="form-label fw-bold text-dark mb-0">
                                    <i class="fa-solid fa-list-check me-2 text-primary"></i>Responsibilities & Key Achievements
                                </label>
                                <button type="button" class="btn btn-outline-primary btn-sm rounded-pill fw-semibold px-3" onclick="addResponsibilityField()">
                                    <i class="fa-solid fa-plus me-1"></i>Add Responsibility
                                </button>
                            </div>
                            <small class="text-muted d-block mb-3">Add bullet points detailing your key tasks, accomplishments, and technologies used.</small>

                            <!-- Dynamic Responsibility Input Rows Container -->
                            <div id="responsibilitiesContainer"></div>
                        </div>
                    </div>
                </div>

                <div class="modal-footer bg-light rounded-bottom-4">
                    <button type="button" class="btn btn-secondary px-4" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary px-4 fw-semibold">Save Experience</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let modalExperience;

        document.addEventListener('DOMContentLoaded', function () {
            modalExperience = new bootstrap.Modal(document.getElementById('modalExperience'));
        });

        function openAddExperienceModal() {
            document.getElementById('modalTitleText').innerText = "Add Experience";
            document.getElementById('expId').value = 0;
            document.getElementById('expJobTitle').value = "";
            document.getElementById('expCompany').value = "";
            document.getElementById('expLocation').value = "";
            document.getElementById('expStartDate').value = "";
            document.getElementById('expEndDate').value = "";
            document.getElementById('expEndDate').disabled = false;
            document.getElementById('expCurrentlyWorking').checked = false;

            const container = document.getElementById('responsibilitiesContainer');
            container.innerHTML = "";
            addResponsibilityField();

            modalExperience.show();
        }

        function addResponsibilityField(value = '') {
            const container = document.getElementById('responsibilitiesContainer');
            const div = document.createElement('div');
            div.className = 'input-group mb-2 responsibility-row';
            div.innerHTML = `
                <span class="input-group-text bg-light text-primary"><i class="fa-solid fa-circle-dot"></i></span>
                <input type="text" name="responsibilitiesList" class="form-control" placeholder="Enter responsibility or key accomplishment..." value="${escapeHtml(value)}" required />
                <button type="button" class="btn btn-outline-danger" onclick="this.closest('.responsibility-row').remove()" title="Remove Point">
                    <i class="fa-solid fa-trash-can"></i>
                </button>
            `;
            container.appendChild(div);
        }

        function toggleEndDate(checkbox) {
            const endDateInput = document.getElementById('expEndDate');
            if (checkbox.checked) {
                endDateInput.value = "";
                endDateInput.disabled = true;
            } else {
                endDateInput.disabled = false;
            }
        }

        function editExperience(data) {
            document.getElementById('modalTitleText').innerText = "Edit Experience";
            document.getElementById('expId').value = data.mstExperienceId;
            document.getElementById('expJobTitle').value = data.jobTitle || "";
            document.getElementById('expCompany').value = data.company || "";
            document.getElementById('expLocation').value = data.location || "";
            document.getElementById('expStartDate').value = data.startDate || "";
            document.getElementById('expEndDate').value = data.endDate || "";
            document.getElementById('expCurrentlyWorking').checked = data.isCurrentlyWorking;
            toggleEndDate(document.getElementById('expCurrentlyWorking'));

            const container = document.getElementById('responsibilitiesContainer');
            container.innerHTML = "";

            if (data.responsibilitiesList && data.responsibilitiesList.length > 0) {
                data.responsibilitiesList.forEach(function (resp) {
                    addResponsibilityField(resp);
                });
            } else {
                addResponsibilityField();
            }

            modalExperience.show();
        }

        function escapeHtml(str) {
            if (!str) return '';
            return str.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;").replace(/'/g, "&#039;");
        }
    </script>
}
