@model BalajiPortfolio.Models.DTO.SkillsPageDTO
@{
    ViewData["Title"] = "Skills & Expertise";
}

<style>
    .skills-card {
        border: none;
        border-radius: 16px;
        box-shadow: 0 8px 26px rgba(0,0,0,0.06);
        background: #ffffff;
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }
    .skills-card:hover {
        box-shadow: 0 12px 32px rgba(0,0,0,0.1);
    }
    .category-badge {
        background: linear-gradient(135deg, #2563eb 0%, #3b82f6 100%);
        color: white;
        font-weight: 600;
        padding: 6px 14px;
        border-radius: 8px;
        display: inline-flex;
        align-items: center;
        gap: 8px;
    }
    .proficiency-pill {
        background: #eff6ff;
        color: #1e40af;
        font-weight: 600;
        font-size: 0.8rem;
        padding: 4px 10px;
        border-radius: 20px;
        border: 1px solid #bfdbfe;
    }

    /* Custom Horizontal Tab Navigation Bar Styling (Unified Blue Theme) */
    .nav-tabs-custom {
        border-bottom: 1px solid #e2e8f0;
        display: flex;
        gap: 32px;
        margin-bottom: 28px;
        padding-left: 4px;
    }
    .nav-tabs-custom .nav-link {
        border: none;
        background: transparent;
        color: #64748b;
        font-weight: 600;
        font-size: 1.05rem;
        padding: 12px 4px;
        position: relative;
        cursor: pointer;
        transition: all 0.2s ease;
    }
    .nav-tabs-custom .nav-link:hover {
        color: #2563eb;
    }
    .nav-tabs-custom .nav-link.active {
        color: #2563eb;
        background: transparent;
        font-weight: 700;
    }
    .nav-tabs-custom .nav-link.active::after {
        content: '';
        position: absolute;
        bottom: -1px;
        left: 0;
        width: 100%;
        height: 3px;
        background-color: #2563eb;
        border-radius: 3px 3px 0 0;
    }
</style>

<div class="container-fluid px-0">

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-3 mb-4 shadow-sm" role="alert">
            <i class="fa-solid fa-circle-check me-2"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show rounded-3 mb-4 shadow-sm" role="alert">
            <i class="fa-solid fa-circle-exclamation me-2"></i> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- HORIZONTAL TAB NAVIGATION BAR (UNIFIED BLUE THEME) -->
    <ul class="nav nav-tabs-custom" id="skillsTabs" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active" id="skill-categories-tab" data-bs-toggle="tab" data-bs-target="#tabSkillCategories" type="button" role="tab" aria-controls="tabSkillCategories" aria-selected="true">
                <i class="fa-solid fa-layer-group me-2"></i>Skill Categories
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="skills-list-tab" data-bs-toggle="tab" data-bs-target="#tabSkillsList" type="button" role="tab" aria-controls="tabSkillsList" aria-selected="false">
                <i class="fa-solid fa-code me-2"></i>Skills & Proficiency
            </button>
        </li>
    </ul>

    <!-- TAB PANELS CONTENT -->
    <div class="tab-content" id="skillsTabsContent">

        <!-- TAB 1: SKILL CATEGORIES (mstSkillCategory) -->
        <div class="tab-pane fade show active" id="tabSkillCategories" role="tabpanel" aria-labelledby="skill-categories-tab">
            <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
                <div>
                    <h3 class="h4 fw-bold text-dark mb-1"><i class="fa-solid fa-layer-group text-primary me-2"></i>Skill Categories</h3>
                    <p class="text-muted mb-0">Manage skill categories (e.g., Backend Development, Frontend, Database)</p>
                </div>
                <button type="button" class="btn btn-primary rounded-3 shadow-sm px-4 fw-semibold" onclick="openAddCategoryModal()">
                    <i class="fa-solid fa-plus me-2"></i>Add Category
                </button>
            </div>

            <div class="card skills-card p-4">
                @if (Model != null && Model.categories != null && Model.categories.Count > 0)
                {
                    <div class="row g-3">
                        @foreach (var cat in Model.categories)
                        {
                            <div class="col-md-6 col-lg-4">
                                <div class="p-3 bg-light rounded-3 border d-flex align-items-center justify-content-between">
                                    <span class="fw-bold text-dark fs-6"><i class="fa-solid fa-folder text-primary me-2"></i>@cat.categoryName</span>
                                    <div class="d-flex gap-2">
                                        <button type="button" class="btn btn-sm btn-outline-primary border-0" onclick='editCategory(@Html.Raw(System.Text.Json.JsonSerializer.Serialize(cat)))' title="Edit Category">
                                            <i class="fa-solid fa-pen"></i>
                                        </button>
                                        <form asp-controller="Skill" asp-action="DeleteCategory" method="post" class="d-inline" onsubmit="return confirm('Deleting this category will also soft delete associated skills. Continue?');">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@cat.mstSkillCategoryId" />
                                            <button type="submit" class="btn btn-sm btn-outline-danger border-0" title="Delete Category">
                                                <i class="fa-solid fa-trash-can"></i>
                                            </button>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="text-center py-5">
                        <i class="fa-solid fa-layer-group text-muted fs-1 mb-3"></i>
                        <h5 class="fw-bold text-dark">No Skill Categories Added Yet</h5>
                        <p class="text-muted mb-4">Click the <strong>"Add Category"</strong> button above to create skill categories.</p>
                        <button type="button" class="btn btn-primary rounded-3 px-4 fw-semibold" onclick="openAddCategoryModal()">
                            <i class="fa-solid fa-plus me-2"></i>Add Category
                        </button>
                    </div>
                }
            </div>
        </div>

        <!-- TAB 2: SKILLS & PROFICIENCY (mstSkill) -->
        <div class="tab-pane fade" id="tabSkillsList" role="tabpanel" aria-labelledby="skills-list-tab">
            <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
                <div>
                    <h3 class="h4 fw-bold text-dark mb-1"><i class="fa-solid fa-code text-primary me-2"></i>Technical Skills & Proficiency</h3>
                    <p class="text-muted mb-0">Manage individual skills under your saved skill categories</p>
                </div>
                <button type="button" class="btn btn-primary rounded-3 shadow-sm px-4 fw-semibold" onclick="openAddSkillModal()">
                    <i class="fa-solid fa-plus me-2"></i>Add Skill
                </button>
            </div>

            <div class="card skills-card p-4">
                @if (Model != null && Model.skills != null && Model.skills.Count > 0)
                {
                    <div class="row g-4">
                        @foreach (var skillGroup in Model.skills.GroupBy(s => s.categoryName))
                        {
                            <div class="col-12">
                                <div class="p-4 bg-light rounded-3 border">
                                    <div class="category-badge mb-3">
                                        <i class="fa-solid fa-folder"></i> @skillGroup.Key
                                    </div>
                                    <div class="row g-3">
                                        @foreach (var s in skillGroup)
                                        {
                                            <div class="col-md-6 col-lg-4">
                                                <div class="p-3 bg-white rounded-3 border d-flex justify-content-between align-items-center shadow-sm">
                                                    <div>
                                                        <span class="fw-bold text-dark d-block mb-1">@s.skillName</span>
                                                        @if (!string.IsNullOrEmpty(s.proficiencyLevel))
                                                        {
                                                            <span class="proficiency-pill"><i class="fa-solid fa-chart-line me-1"></i>@s.proficiencyLevel</span>
                                                        }
                                                    </div>
                                                    <div class="d-flex gap-1">
                                                        <button type="button" class="btn btn-sm text-primary p-1" onclick='editSkill(@Html.Raw(System.Text.Json.JsonSerializer.Serialize(s)))' title="Edit Skill">
                                                            <i class="fa-solid fa-pen"></i>
                                                        </button>
                                                        <form asp-controller="Skill" asp-action="DeleteSkill" method="post" class="d-inline" onsubmit="return confirm('Are you sure you want to delete this skill?');">
                                                            @Html.AntiForgeryToken()
                                                            <input type="hidden" name="id" value="@s.mstSkillId" />
                                                            <button type="submit" class="btn btn-sm text-danger p-1" title="Delete Skill">
                                                                <i class="fa-solid fa-trash"></i>
                                                            </button>
                                                        </form>
                                                    </div>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="text-center py-5">
                        <i class="fa-solid fa-laptop-code text-muted fs-1 mb-3"></i>
                        <h5 class="fw-bold text-dark">No Technical Skills Added Yet</h5>
                        <p class="text-muted mb-4">Click the <strong>"Add Skill"</strong> button above to populate your skill set.</p>
                        <button type="button" class="btn btn-primary rounded-3 px-4 fw-semibold" onclick="openAddSkillModal()">
                            <i class="fa-solid fa-plus me-2"></i>Add Skill
                        </button>
                    </div>
                }
            </div>
        </div>

    </div>

</div>

<!-- ================================================================= -->
<!-- MODAL 1: Add / Edit Skill Category (mstSkillCategory) -->
<!-- ================================================================= -->
<div class="modal fade" id="modalCategory" tabindex="-1" aria-labelledby="modalCategoryLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-4">
            <div class="modal-header bg-primary text-white rounded-top-4">
                <h5 class="modal-title fw-bold" id="modalCategoryLabel">
                    <i class="fa-solid fa-folder-plus me-2"></i><span id="modalCategoryTitleText">Add Category</span>
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-controller="Skill" asp-action="SaveCategory" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="mstSkillCategoryId" id="catId" value="0" />

                <div class="modal-body p-4">
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Category Name <span class="text-danger">*</span></label>
                        <input type="text" name="categoryName" id="catName" class="form-control" placeholder="e.g. Backend Development, Frontend, Database, Cloud" required />
                    </div>
                </div>

                <div class="modal-footer bg-light rounded-bottom-4">
                    <button type="button" class="btn btn-secondary px-4" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary px-4 fw-semibold">Save Category</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- ================================================================= -->
<!-- MODAL 2: Add / Edit Skill (mstSkill) -->
<!-- ================================================================= -->
<div class="modal fade" id="modalSkill" tabindex="-1" aria-labelledby="modalSkillLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-4">
            <div class="modal-header bg-primary text-white rounded-top-4">
                <h5 class="modal-title fw-bold" id="modalSkillLabel">
                    <i class="fa-solid fa-code me-2"></i><span id="modalSkillTitleText">Add Skill</span>
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-controller="Skill" asp-action="SaveSkill" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="mstSkillId" id="skillId" value="0" />

                <div class="modal-body p-4">
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Skill Category <span class="text-danger">*</span></label>
                        <select name="mstSkillCategoryId" id="skillCatId" class="form-select" required>
                            <option value="">-- Select Category --</option>
                            @if (Model != null && Model.categories != null)
                            {
                                foreach (var cat in Model.categories)
                                {
                                    <option value="@cat.mstSkillCategoryId">@cat.categoryName</option>
                                }
                            }
                        </select>
                        <small class="text-muted">Select category from <strong>mstSkillCategory</strong></small>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Skill Name <span class="text-danger">*</span></label>
                        <input type="text" name="skillName" id="skillNameInput" class="form-control" placeholder="e.g. C# / ASP.NET Core, React, SQL Server" required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Proficiency Level</label>
                        <select name="proficiencyLevel" id="skillProficiency" class="form-select">
                            <option value="Beginner">Beginner</option>
                            <option value="Intermediate">Intermediate</option>
                            <option value="Advanced" selected>Advanced</option>
                            <option value="Expert">Expert</option>
                        </select>
                    </div>
                </div>

                <div class="modal-footer bg-light rounded-bottom-4">
                    <button type="button" class="btn btn-secondary px-4" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary px-4 fw-semibold">Save Skill</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let modalCategory;
        let modalSkill;

        document.addEventListener('DOMContentLoaded', function () {
            modalCategory = new bootstrap.Modal(document.getElementById('modalCategory'));
            modalSkill = new bootstrap.Modal(document.getElementById('modalSkill'));
        });

        function openAddCategoryModal() {
            document.getElementById('modalCategoryTitleText').innerText = "Add Category";
            document.getElementById('catId').value = 0;
            document.getElementById('catName').value = "";
            modalCategory.show();
        }

        function editCategory(cat) {
            document.getElementById('modalCategoryTitleText').innerText = "Edit Category";
            document.getElementById('catId').value = cat.mstSkillCategoryId;
            document.getElementById('catName').value = cat.categoryName || "";
            modalCategory.show();
        }

        function openAddSkillModal() {
            document.getElementById('modalSkillTitleText').innerText = "Add Skill";
            document.getElementById('skillId').value = 0;
            document.getElementById('skillCatId').value = "";
            document.getElementById('skillNameInput').value = "";
            document.getElementById('skillProficiency').value = "Advanced";
            modalSkill.show();
        }

        function editSkill(skill) {
            document.getElementById('modalSkillTitleText').innerText = "Edit Skill";
            document.getElementById('skillId').value = skill.mstSkillId;
            document.getElementById('skillCatId').value = skill.mstSkillCategoryId || "";
            document.getElementById('skillNameInput').value = skill.skillName || "";
            document.getElementById('skillProficiency').value = skill.proficiencyLevel || "Advanced";
            modalSkill.show();
        }
    </script>
}
