@{
    ViewData["Title"] = "Skills & Expertise";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="h4 fw-bold text-dark mb-1"><i class="fa-solid fa-code text-success me-2"></i>Skills Management</h2>
        <p class="text-muted mb-0">Manage technical skills, proficiency levels, and categories</p>
    </div>
    <button class="btn btn-success rounded-3 px-4 fw-semibold">
        <i class="fa-solid fa-plus me-2"></i>Add Skill
    </button>
</div>

<div class="card border-0 shadow-sm rounded-4">
    <div class="card-body p-4 text-center py-5">
        <i class="fa-solid fa-laptop-code text-muted fs-1 mb-3"></i>
        <h5 class="fw-bold text-dark">No Skills Added Yet</h5>
        <p class="text-muted mb-3">Click the "Add Skill" button above to list your technical competencies.</p>
    </div>
</div>
