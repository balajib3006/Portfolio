@model BalajiPortfolio.Models.DTO.PortfolioViewModel
@{
    Layout = null;
    var personal = Model?.Personal ?? new BalajiPortfolio.Models.DTO.PersonalDTO();
    var experiences = Model?.Experiences ?? new List<BalajiPortfolio.Models.DTO.ExperienceDTO>();
    var skills = Model?.Skills ?? new List<BalajiPortfolio.Models.DTO.SkillDTO>();
    var projects = Model?.Projects ?? new List<BalajiPortfolio.Models.DTO.ProjectDTO>();
    var certifications = Model?.Certifications ?? new List<BalajiPortfolio.Models.DTO.CertificationDTO>();
    var publications = Model?.Publications ?? new List<BalajiPortfolio.Models.DTO.PublicationDTO>();

    // Personal details
    bool hasName = !string.IsNullOrWhiteSpace(personal.name);
    string displayName = hasName ? personal.name! : "Portfolio";
    string initials = hasName 
        ? string.Join("", personal.name!.Split(' ', StringSplitOptions.RemoveEmptyEntries).Select(s => s[0])).ToUpper()
        : "P";
    if (initials.Length > 2) initials = initials.Substring(0, 2);

    bool hasBio = !string.IsNullOrWhiteSpace(personal.bio);
    bool hasSummary = !string.IsNullOrWhiteSpace(personal.professionalSummary);
    bool hasLocation = !string.IsNullOrWhiteSpace(personal.location);
    bool hasWorkDetails = !string.IsNullOrWhiteSpace(personal.workDetails);
    bool hasEmail = !string.IsNullOrWhiteSpace(personal.email);
    bool hasMobile = !string.IsNullOrWhiteSpace(personal.mobileNumber);

    // Social & Academic links
    bool hasLinkedIn = !string.IsNullOrWhiteSpace(personal.linkedInUrl);
    bool hasGitHub = !string.IsNullOrWhiteSpace(personal.gitHubUrl);
    bool hasGitLab = !string.IsNullOrWhiteSpace(personal.gitLabUrl);
    bool hasScholar = !string.IsNullOrWhiteSpace(personal.googleScholarUrl);
    bool hasOrcid = !string.IsNullOrWhiteSpace(personal.orcidUrl);
    bool hasAnySocial = hasLinkedIn || hasGitHub || hasGitLab || hasScholar || hasOrcid || hasEmail || hasMobile;
    bool hasAcademic = hasScholar || hasOrcid;

    // Real stats only (no dummy or hardcoded numbers)
    bool hasExpYears = !string.IsNullOrWhiteSpace(personal.yearsOfExperience);
    string expYears = personal.yearsOfExperience ?? "";

    bool hasProjectsCount = !string.IsNullOrWhiteSpace(personal.projectsCompleted) || projects.Count > 0;
    string projectsCountStr = !string.IsNullOrWhiteSpace(personal.projectsCompleted) 
        ? personal.projectsCompleted! 
        : (projects.Count > 0 ? projects.Count.ToString() : "");

    bool hasCompaniesCount = !string.IsNullOrWhiteSpace(personal.companiesWorked) || experiences.Count > 0;
    string companiesCountStr = !string.IsNullOrWhiteSpace(personal.companiesWorked) 
        ? personal.companiesWorked! 
        : (experiences.Count > 0 ? experiences.Count.ToString() : "");

    int totalCredentials = certifications.Count + publications.Count;
    bool hasCredentialsCount = totalCredentials > 0;
    string credentialsCountStr = totalCredentials > 0 ? totalCredentials.ToString() : "";

    bool hasAnyStats = hasExpYears || hasProjectsCount || hasCompaniesCount || hasCredentialsCount;

    // Section visibility flags
    bool hasAboutSection = hasSummary || hasAcademic;
    bool hasExperienceSection = experiences.Count > 0;
    bool hasSkillsSection = skills.Count > 0;
    bool hasProjectsSection = projects.Count > 0;
    bool hasCertificationsSection = certifications.Count > 0;
    bool hasPublicationsSection = publications.Count > 0;
    bool hasContactSection = hasEmail || hasMobile || hasLocation || hasAnySocial;

    // Distinct project tags
    var allTags = projects
        .SelectMany(p => p.tagsList ?? new List<string>())
        .Where(t => !string.IsNullOrWhiteSpace(t))
        .Distinct()
        .ToList();
}
<!DOCTYPE html>
<html lang="en" data-bs-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(hasName ? displayName : "Portfolio")</title>
    <meta name="description" content="@displayName's Engineering Portfolio showcasing verified projects, skills, research, and technical achievements." />

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:ital,wght@0,300;0,400;0,500;0,600;0,700;0,800;1,400&family=Space+Grotesk:wght@500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />

    <!-- Bootstrap 5.3 & FontAwesome -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />

    <!-- AOS (Animate on Scroll) -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/aos/2.3.4/aos.css" />

    <style>
        :root {
            --bg-canvas: #090d16;
            --bg-surface: #0f172a;
            --bg-card: rgba(17, 24, 39, 0.72);
            --bg-card-hover: rgba(30, 41, 59, 0.85);
            --border-glass: rgba(255, 255, 255, 0.08);
            --border-accent: rgba(99, 102, 241, 0.3);
            
            --primary: #6366f1;
            --primary-light: #818cf8;
            --secondary: #06b6d4;
            --accent-purple: #a855f7;
            --accent-emerald: #10b981;
            --accent-amber: #f59e0b;

            --text-main: #f8fafc;
            --text-muted: #94a3b8;
            --text-sub: #cbd5e1;

            --gradient-primary: linear-gradient(135deg, #6366f1 0%, #06b6d4 100%);
            --gradient-card: linear-gradient(145deg, rgba(30, 41, 59, 0.6) 0%, rgba(15, 23, 42, 0.8) 100%);
        }

        * {
            box-sizing: border-box;
            scroll-behavior: smooth;
        }

        body {
            background-color: var(--bg-canvas);
            color: var(--text-main);
            font-family: 'Plus Jakarta Sans', system-ui, -apple-system, sans-serif;
            overflow-x: hidden;
            line-height: 1.65;
            position: relative;
        }

        /* Ambient Glow & Canvas */
        #bgCanvas {
            position: fixed;
            top: 0;
            left: 0;
            width: 100vw;
            height: 100vh;
            pointer-events: none;
            z-index: 0;
            opacity: 0.5;
        }

        .ambient-sphere {
            position: fixed;
            border-radius: 50%;
            filter: blur(120px);
            pointer-events: none;
            z-index: 0;
            opacity: 0.16;
            animation: floatGlow 18s ease-in-out infinite alternate;
        }

        .ambient-sphere-1 {
            width: 500px;
            height: 500px;
            top: -100px;
            left: -100px;
            background: #4f46e5;
        }

        .ambient-sphere-2 {
            width: 600px;
            height: 600px;
            bottom: 10%;
            right: -150px;
            background: #06b6d4;
            animation-duration: 22s;
        }

        @@keyframes floatGlow {
            0% { transform: translate(0, 0) scale(1); }
            50% { transform: translate(40px, 60px) scale(1.1); }
            100% { transform: translate(-30px, 30px) scale(0.95); }
        }

        /* Glassmorphism */
        .glass-panel {
            background: var(--bg-card);
            backdrop-filter: blur(18px);
            -webkit-backdrop-filter: blur(18px);
            border: 1px solid var(--border-glass);
            border-radius: 20px;
            transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
        }

        .glass-panel:hover {
            border-color: rgba(99, 102, 241, 0.4);
            box-shadow: 0 16px 36px -10px rgba(0, 0, 0, 0.4), 0 0 24px -6px rgba(99, 102, 241, 0.25);
            transform: translateY(-4px);
        }

        /* Typography & Headers */
        h1, h2, h3, h4, .font-heading {
            font-family: 'Space Grotesk', sans-serif;
            letter-spacing: -0.02em;
        }

        .font-mono {
            font-family: 'JetBrains Mono', monospace;
        }

        .text-gradient {
            background: var(--gradient-primary);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .text-gradient-purple {
            background: linear-gradient(135deg, #c084fc 0%, #6366f1 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .section-badge {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 6px 14px;
            border-radius: 9999px;
            font-size: 0.8rem;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.08em;
            background: rgba(99, 102, 241, 0.12);
            color: var(--primary-light);
            border: 1px solid rgba(99, 102, 241, 0.25);
            margin-bottom: 14px;
        }

        /* Navbar */
        .portfolio-nav {
            position: fixed;
            top: 16px;
            left: 50%;
            transform: translateX(-50%);
            width: min(94%, 1240px);
            z-index: 1050;
            background: rgba(15, 23, 42, 0.85);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 9999px;
            padding: 10px 24px;
            transition: all 0.3s ease;
        }

        .portfolio-nav.scrolled {
            top: 10px;
            background: rgba(11, 15, 25, 0.95);
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);
        }

        .nav-logo {
            display: flex;
            align-items: center;
            gap: 10px;
            font-family: 'Space Grotesk', sans-serif;
            font-weight: 700;
            font-size: 1.15rem;
            color: #ffffff;
            text-decoration: none;
        }

        .nav-logo-badge {
            width: 36px;
            height: 36px;
            border-radius: 10px;
            background: var(--gradient-primary);
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-weight: 800;
            font-size: 0.95rem;
            box-shadow: 0 4px 12px rgba(99, 102, 241, 0.35);
        }

        .nav-links {
            display: flex;
            align-items: center;
            gap: 6px;
            list-style: none;
            margin: 0;
            padding: 0;
        }

        .nav-link-custom {
            color: var(--text-muted);
            text-decoration: none;
            font-size: 0.9rem;
            font-weight: 500;
            padding: 8px 16px;
            border-radius: 9999px;
            transition: all 0.2s ease;
        }

        .nav-link-custom:hover, .nav-link-custom.active {
            color: #ffffff;
            background: rgba(255, 255, 255, 0.08);
        }

        .btn-gradient {
            background: var(--gradient-primary);
            color: #ffffff;
            border: none;
            padding: 9px 22px;
            border-radius: 9999px;
            font-weight: 600;
            font-size: 0.88rem;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            text-decoration: none;
            transition: all 0.3s ease;
            box-shadow: 0 4px 16px rgba(99, 102, 241, 0.35);
        }

        .btn-gradient:hover {
            color: #ffffff;
            transform: translateY(-2px);
            box-shadow: 0 8px 24px rgba(6, 182, 212, 0.45);
        }

        .btn-glass {
            background: rgba(255, 255, 255, 0.06);
            color: var(--text-main);
            border: 1px solid var(--border-glass);
            padding: 9px 20px;
            border-radius: 9999px;
            font-weight: 600;
            font-size: 0.88rem;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            text-decoration: none;
            transition: all 0.2s ease;
        }

        .btn-glass:hover {
            background: rgba(255, 255, 255, 0.12);
            color: #ffffff;
            border-color: rgba(255, 255, 255, 0.2);
            transform: translateY(-2px);
        }

        /* Hero Section */
        .hero-section {
            padding-top: 150px;
            padding-bottom: 70px;
            position: relative;
            z-index: 1;
        }

        .status-dot {
            width: 8px;
            height: 8px;
            border-radius: 50%;
            background-color: var(--accent-emerald);
            display: inline-block;
            box-shadow: 0 0 10px var(--accent-emerald);
            animation: pulseDot 2s infinite;
        }

        @@keyframes pulseDot {
            0%, 100% { opacity: 1; transform: scale(1); }
            50% { opacity: 0.4; transform: scale(1.3); }
        }

        .avatar-wrapper {
            position: relative;
            width: 300px;
            height: 300px;
            margin: 0 auto;
        }

        .avatar-glow {
            position: absolute;
            inset: -6px;
            border-radius: 50%;
            background: var(--gradient-primary);
            opacity: 0.65;
            filter: blur(14px);
            z-index: 0;
            animation: rotateGlow 12s linear infinite;
        }

        @@keyframes rotateGlow {
            from { transform: rotate(0deg); }
            to { transform: rotate(360deg); }
        }

        .avatar-img {
            position: relative;
            z-index: 1;
            width: 100%;
            height: 100%;
            object-fit: cover;
            border-radius: 50%;
            border: 4px solid #1e293b;
            background: #1e293b;
        }

        .avatar-fallback {
            position: relative;
            z-index: 1;
            width: 100%;
            height: 100%;
            border-radius: 50%;
            border: 4px solid #1e293b;
            background: linear-gradient(135deg, #1e1b4b 0%, #0f172a 100%);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 5rem;
            font-weight: 800;
            color: #ffffff;
            font-family: 'Space Grotesk', sans-serif;
            text-shadow: 0 4px 18px rgba(99, 102, 241, 0.5);
        }

        /* Stats Strip */
        .stat-card {
            padding: 22px;
            border-radius: 18px;
            background: rgba(17, 24, 39, 0.6);
            border: 1px solid var(--border-glass);
            text-align: center;
            position: relative;
            overflow: hidden;
            height: 100%;
        }

        .stat-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 2px;
            background: var(--gradient-primary);
            opacity: 0.8;
        }

        .stat-number {
            font-family: 'Space Grotesk', sans-serif;
            font-size: 2.2rem;
            font-weight: 800;
            color: #ffffff;
            line-height: 1.1;
        }

        .stat-label {
            font-size: 0.84rem;
            color: var(--text-muted);
            text-transform: uppercase;
            letter-spacing: 0.05em;
            margin-top: 6px;
        }

        /* Social Icons & Top-Right Connect */
        .social-link {
            width: 42px;
            height: 42px;
            border-radius: 12px;
            background: rgba(255, 255, 255, 0.05);
            border: 1px solid var(--border-glass);
            color: var(--text-sub);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.1rem;
            transition: all 0.25s ease;
            text-decoration: none;
        }

        .social-link:hover {
            color: #ffffff;
            background: var(--primary);
            border-color: var(--primary-light);
            transform: translateY(-3px);
            box-shadow: 0 6px 16px rgba(99, 102, 241, 0.35);
        }

        .nav-social-icon {
            width: 34px;
            height: 34px;
            border-radius: 50%;
            background: rgba(255, 255, 255, 0.06);
            border: 1px solid var(--border-glass);
            color: var(--text-sub);
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-size: 0.95rem;
            transition: all 0.2s ease;
            text-decoration: none;
        }

        .nav-social-icon:hover {
            color: #ffffff;
            background: var(--primary);
            border-color: var(--primary-light);
            transform: translateY(-2px);
            box-shadow: 0 4px 12px rgba(99, 102, 241, 0.35);
        }

        .hero-top-connect {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            background: rgba(15, 23, 42, 0.7);
            backdrop-filter: blur(12px);
            border: 1px solid var(--border-glass);
            padding: 6px 16px;
            border-radius: 9999px;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.25);
        }

        .social-link-sm {
            width: 32px;
            height: 32px;
            border-radius: 8px;
            background: rgba(255, 255, 255, 0.05);
            border: 1px solid var(--border-glass);
            color: var(--text-sub);
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-size: 0.9rem;
            transition: all 0.2s ease;
            text-decoration: none;
        }

        .social-link-sm:hover {
            color: #ffffff;
            background: var(--primary);
            border-color: var(--primary-light);
            transform: translateY(-2px);
        }

        /* Top Badges Below Name */
        .badge-status-pill {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 7px 16px;
            border-radius: 9999px;
            font-size: 0.82rem;
            font-weight: 600;
            color: #34d399;
            background: rgba(16, 185, 129, 0.12);
            border: 1px solid rgba(16, 185, 129, 0.28);
        }

        .bg-surface-badge {
            background: rgba(255, 255, 255, 0.06);
            color: #cbd5e1;
            font-weight: 500;
            border: 1px solid var(--border-glass);
            font-size: 0.82rem;
            padding: 7px 14px;
        }

        /* Timeline / Experience */
        .timeline-container {
            position: relative;
            padding-left: 28px;
        }

        .timeline-container::before {
            content: '';
            position: absolute;
            left: 7px;
            top: 10px;
            bottom: 10px;
            width: 2px;
            background: linear-gradient(180deg, #6366f1 0%, #06b6d4 50%, rgba(255, 255, 255, 0.1) 100%);
        }

        .timeline-node {
            position: relative;
            margin-bottom: 38px;
        }

        .timeline-dot {
            position: absolute;
            left: -28px;
            top: 6px;
            width: 16px;
            height: 16px;
            border-radius: 50%;
            background: var(--bg-canvas);
            border: 3px solid var(--primary-light);
            box-shadow: 0 0 10px rgba(99, 102, 241, 0.6);
            z-index: 2;
        }

        .timeline-node.current .timeline-dot {
            border-color: var(--accent-emerald);
            box-shadow: 0 0 12px var(--accent-emerald);
            background: var(--accent-emerald);
        }

        /* Skills Matrix */
        .skill-card {
            padding: 18px 20px;
            border-radius: 14px;
            background: rgba(17, 24, 39, 0.5);
            border: 1px solid var(--border-glass);
            transition: all 0.25s ease;
            height: 100%;
        }

        .skill-card:hover {
            background: rgba(30, 41, 59, 0.7);
            border-color: rgba(99, 102, 241, 0.4);
            transform: translateY(-2px);
        }

        .skill-badge {
            font-size: 0.75rem;
            font-weight: 700;
            padding: 4px 10px;
            border-radius: 6px;
            text-transform: capitalize;
            letter-spacing: 0.03em;
        }

        .badge-expert {
            background: rgba(16, 185, 129, 0.15);
            color: #34d399;
            border: 1px solid rgba(16, 185, 129, 0.3);
        }

        .badge-advanced {
            background: rgba(99, 102, 241, 0.15);
            color: #a5b4fc;
            border: 1px solid rgba(99, 102, 241, 0.3);
        }

        .badge-intermediate {
            background: rgba(6, 182, 212, 0.15);
            color: #67e8f9;
            border: 1px solid rgba(6, 182, 212, 0.3);
        }

        .badge-beginner {
            background: rgba(245, 158, 11, 0.15);
            color: #fcd34d;
            border: 1px solid rgba(245, 158, 11, 0.3);
        }

        /* Filter Buttons */
        .filter-btn {
            background: rgba(255, 255, 255, 0.05);
            color: var(--text-muted);
            border: 1px solid var(--border-glass);
            padding: 6px 16px;
            border-radius: 9999px;
            font-size: 0.84rem;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.2s ease;
        }

        .filter-btn:hover, .filter-btn.active {
            color: #ffffff;
            background: rgba(99, 102, 241, 0.25);
            border-color: var(--primary-light);
        }

        /* Projects & CAD */
        .project-card {
            border-radius: 20px;
            overflow: hidden;
            background: var(--bg-card);
            border: 1px solid var(--border-glass);
            transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
            height: 100%;
            display: flex;
            flex-direction: column;
        }

        .project-card:hover {
            border-color: rgba(6, 182, 212, 0.4);
            transform: translateY(-6px);
            box-shadow: 0 20px 40px -15px rgba(0, 0, 0, 0.6), 0 0 25px rgba(6, 182, 212, 0.2);
        }

        .project-thumb-box {
            position: relative;
            width: 100%;
            height: 220px;
            overflow: hidden;
            background: linear-gradient(135deg, #1e1b4b 0%, #0f172a 100%);
        }

        .project-img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform 0.4s ease;
        }

        .project-card:hover .project-img {
            transform: scale(1.06);
        }

        .project-placeholder-icon {
            width: 100%;
            height: 100%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 3.5rem;
            color: rgba(99, 102, 241, 0.4);
            background: radial-gradient(circle, rgba(99, 102, 241, 0.15) 0%, transparent 70%);
        }

        .cad-badge-floating {
            position: absolute;
            top: 12px;
            right: 12px;
            background: rgba(6, 182, 212, 0.85);
            backdrop-filter: blur(8px);
            color: #ffffff;
            font-size: 0.75rem;
            font-weight: 700;
            padding: 4px 10px;
            border-radius: 9999px;
            display: flex;
            align-items: center;
            gap: 5px;
            box-shadow: 0 4px 12px rgba(6, 182, 212, 0.4);
        }

        .tag-pill {
            font-size: 0.74rem;
            font-weight: 500;
            padding: 3px 10px;
            border-radius: 6px;
            background: rgba(255, 255, 255, 0.05);
            color: var(--text-sub);
            border: 1px solid rgba(255, 255, 255, 0.08);
        }

        /* 3D CAD Modal Canvas */
        #cadViewerContainer {
            width: 100%;
            height: 420px;
            background: radial-gradient(circle at center, #1e293b 0%, #0a0f1d 100%);
            border-radius: 16px;
            position: relative;
            overflow: hidden;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        #cadCanvas {
            width: 100% !important;
            height: 100% !important;
            outline: none;
        }

        .cad-toolbar {
            position: absolute;
            bottom: 14px;
            left: 50%;
            transform: translateX(-50%);
            background: rgba(15, 23, 42, 0.85);
            backdrop-filter: blur(12px);
            border: 1px solid var(--border-glass);
            border-radius: 9999px;
            padding: 6px 14px;
            display: flex;
            gap: 8px;
            z-index: 10;
        }

        .cad-btn-tool {
            background: transparent;
            border: none;
            color: #ffffff;
            font-size: 0.82rem;
            padding: 4px 10px;
            border-radius: 9999px;
            cursor: pointer;
            transition: all 0.2s;
        }

        .cad-btn-tool:hover, .cad-btn-tool.active {
            background: rgba(99, 102, 241, 0.4);
            color: #67e8f9;
        }

        /* Credential Card */
        .credential-card {
            border-radius: 16px;
            background: var(--bg-card);
            border: 1px solid var(--border-glass);
            padding: 24px;
            height: 100%;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            transition: all 0.3s ease;
        }

        .credential-card:hover {
            border-color: rgba(168, 85, 247, 0.4);
            transform: translateY(-4px);
            box-shadow: 0 12px 28px rgba(0, 0, 0, 0.35);
        }

        .pub-paper-badge {
            width: 44px;
            height: 44px;
            border-radius: 12px;
            background: rgba(168, 85, 247, 0.15);
            color: #c084fc;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.25rem;
            flex-shrink: 0;
            border: 1px solid rgba(168, 85, 247, 0.3);
        }

        /* Contact Section & Digital Business Card */
        .business-card-wrapper {
            perspective: 1200px;
        }

        .business-card {
            position: relative;
            width: 100%;
            border-radius: 24px;
            background: linear-gradient(145deg, rgba(30, 41, 59, 0.9) 0%, rgba(15, 23, 42, 0.98) 100%);
            border: 1px solid rgba(255, 255, 255, 0.16);
            padding: 32px;
            box-shadow: 0 25px 60px -15px rgba(0, 0, 0, 0.7), 0 0 40px rgba(99, 102, 241, 0.18);
            overflow: hidden;
            transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.25s ease;
            transform-style: preserve-3d;
        }

        .business-card:hover {
            box-shadow: 0 30px 70px -10px rgba(0, 0, 0, 0.8), 0 0 50px rgba(6, 182, 212, 0.25);
            border-color: rgba(6, 182, 212, 0.45);
        }

        .business-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 4px;
            background: var(--gradient-primary);
        }

        .business-card-hologram {
            position: absolute;
            top: -40%;
            right: -40%;
            width: 320px;
            height: 320px;
            border-radius: 50%;
            background: radial-gradient(circle, rgba(99, 102, 241, 0.15) 0%, rgba(6, 182, 212, 0.08) 50%, transparent 70%);
            pointer-events: none;
            filter: blur(40px);
        }

        .business-card-chip {
            width: 48px;
            height: 36px;
            border-radius: 8px;
            background: linear-gradient(135deg, #f59e0b 0%, #d97706 60%, #92400e 100%);
            border: 1px solid rgba(255, 255, 255, 0.4);
            position: relative;
            box-shadow: inset 0 1px 4px rgba(255, 255, 255, 0.5), 0 3px 10px rgba(0, 0, 0, 0.4);
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .business-card-chip-lines {
            width: 26px;
            height: 18px;
            border: 1px solid rgba(0, 0, 0, 0.35);
            border-radius: 4px;
            position: relative;
        }

        .business-card-chip-lines::before {
            content: '';
            position: absolute;
            top: 50%;
            left: 0;
            right: 0;
            height: 1px;
            background: rgba(0, 0, 0, 0.3);
        }

        .business-card-name {
            font-family: 'Space Grotesk', sans-serif;
            font-weight: 800;
            font-size: 1.75rem;
            color: #ffffff;
            letter-spacing: -0.02em;
            line-height: 1.15;
        }

        .business-card-title {
            font-size: 0.95rem;
            color: var(--secondary);
            font-weight: 600;
            letter-spacing: 0.02em;
        }

        .business-card-org {
            font-size: 0.82rem;
            color: #94a3b8;
            font-weight: 500;
        }

        .business-card-item {
            display: flex;
            align-items: center;
            gap: 14px;
            color: #cbd5e1;
            font-size: 0.92rem;
            text-decoration: none;
            padding: 10px 14px;
            border-radius: 12px;
            background: rgba(255, 255, 255, 0.03);
            border: 1px solid rgba(255, 255, 255, 0.06);
            transition: all 0.2s ease;
        }

        .business-card-item:hover {
            background: rgba(99, 102, 241, 0.15);
            border-color: rgba(99, 102, 241, 0.35);
            color: #ffffff;
            transform: translateX(4px);
        }

        .business-card-item i {
            width: 20px;
            text-align: center;
            color: var(--primary-light);
            font-size: 1.05rem;
        }

        .btn-card-action {
            background: rgba(255, 255, 255, 0.06);
            border: 1px solid var(--border-glass);
            color: #ffffff;
            padding: 9px 18px;
            border-radius: 12px;
            font-size: 0.85rem;
            font-weight: 600;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            cursor: pointer;
            transition: all 0.2s ease;
        }

        .btn-card-action:hover {
            background: var(--primary);
            border-color: var(--primary-light);
            color: #ffffff;
        }

        /* 3D CAD HUD and Loader */
        .cad-model-hud {
            position: absolute;
            top: 14px;
            left: 14px;
            background: rgba(15, 23, 42, 0.85);
            backdrop-filter: blur(8px);
            border: 1px solid var(--border-glass);
            color: #38bdf8;
            font-size: 0.78rem;
            font-weight: 600;
            padding: 6px 14px;
            border-radius: 9999px;
            display: flex;
            align-items: center;
            gap: 6px;
            z-index: 10;
            font-family: 'JetBrains Mono', monospace;
        }

        .cad-loading-overlay {
            position: absolute;
            inset: 0;
            background: rgba(10, 15, 29, 0.88);
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            gap: 12px;
            color: #38bdf8;
            font-size: 0.9rem;
            z-index: 20;
            transition: opacity 0.3s ease;
        }

        .contact-item-box {
            display: flex;
            align-items: center;
            gap: 16px;
            padding: 16px 20px;
            border-radius: 14px;
            background: rgba(255, 255, 255, 0.03);
            border: 1px solid var(--border-glass);
            transition: all 0.2s ease;
            text-decoration: none;
            color: inherit;
        }

        .contact-item-box:hover {
            background: rgba(99, 102, 241, 0.08);
            border-color: rgba(99, 102, 241, 0.3);
            color: #ffffff;
            transform: translateX(4px);
        }

        .contact-icon-box {
            width: 46px;
            height: 46px;
            border-radius: 12px;
            background: var(--gradient-primary);
            color: white;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.2rem;
            flex-shrink: 0;
        }

        .form-control-glass {
            background: rgba(15, 23, 42, 0.6);
            border: 1px solid rgba(255, 255, 255, 0.12);
            border-radius: 12px;
            color: #ffffff;
            padding: 12px 18px;
            font-size: 0.95rem;
            transition: all 0.2s ease;
        }

        .form-control-glass:focus {
            background: rgba(15, 23, 42, 0.85);
            border-color: var(--primary-light);
            box-shadow: 0 0 16px rgba(99, 102, 241, 0.3);
            color: #ffffff;
        }

        .form-control-glass::placeholder {
            color: #64748b;
        }

        .portfolio-footer {
            border-top: 1px solid var(--border-glass);
            padding: 40px 0 30px;
            background: rgba(7, 10, 18, 0.9);
            position: relative;
            z-index: 1;
        }

        .btn-top {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            background: rgba(255, 255, 255, 0.08);
            border: 1px solid var(--border-glass);
            color: #ffffff;
            display: flex;
            align-items: center;
            justify-content: center;
            text-decoration: none;
            transition: all 0.25s ease;
        }

        .btn-top:hover {
            background: var(--primary);
            color: #ffffff;
            transform: translateY(-3px);
        }

        @@media (max-width: 991.98px) {
            .portfolio-nav {
                border-radius: 18px;
                padding: 12px 20px;
            }
            .nav-links {
                display: none;
            }
            .nav-links.mobile-open {
                display: flex;
                flex-direction: column;
                position: absolute;
                top: 70px;
                left: 0;
                right: 0;
                background: rgba(11, 15, 25, 0.98);
                border: 1px solid var(--border-glass);
                border-radius: 18px;
                padding: 16px;
                gap: 8px;
            }
            .hero-section {
                padding-top: 120px;
                text-align: center;
            }
            .avatar-wrapper {
                margin-top: 30px;
                width: 240px;
                height: 240px;
            }
            .timeline-container {
                padding-left: 20px;
            }
            .timeline-dot {
                left: -20px;
            }
        }
    </style>
</head>
<body>

    <!-- Ambient Glowing Spheres & Dynamic Background Canvas -->
    <canvas id="bgCanvas"></canvas>
    <div class="ambient-sphere ambient-sphere-1"></div>
    <div class="ambient-sphere ambient-sphere-2"></div>

    <!-- Floating Glass Navbar -->
    <nav class="portfolio-nav" id="mainNav">
        <div class="d-flex align-items-center justify-content-between">
            <a href="#hero" class="nav-logo">
                <div class="nav-logo-badge">@initials</div>
                <span>@displayName</span>
            </a>

            <!-- Dynamic Nav Links (Only displays sections that actually have data) -->
            <ul class="nav-links" id="navLinksList">
                @if (hasAboutSection)
                {
                    <li><a href="#about" class="nav-link-custom">About</a></li>
                }
                @if (hasExperienceSection)
                {
                    <li><a href="#experience" class="nav-link-custom">Experience</a></li>
                }
                @if (hasSkillsSection)
                {
                    <li><a href="#skills" class="nav-link-custom">Skills</a></li>
                }
                @if (hasProjectsSection)
                {
                    <li><a href="#projects" class="nav-link-custom">Projects</a></li>
                }
                @if (hasCertificationsSection)
                {
                    <li><a href="#certifications" class="nav-link-custom">Certifications</a></li>
                }
                @if (hasPublicationsSection)
                {
                    <li><a href="#publications" class="nav-link-custom">Publications</a></li>
                }
                @if (hasContactSection)
                {
                    <li><a href="#contact" class="nav-link-custom">Contact</a></li>
                }
            </ul>

            <!-- Nav Action Buttons & Top-Right Connect -->
            <div class="d-flex align-items-center gap-2">
                @if (hasAnySocial)
                {
                    <div class="d-none d-md-flex align-items-center gap-1 me-2">
                        @if (hasLinkedIn)
                        {
                            <a href="@personal.linkedInUrl" target="_blank" class="nav-social-icon" title="LinkedIn"><i class="fa-brands fa-linkedin-in"></i></a>
                        }
                        @if (hasGitHub)
                        {
                            <a href="@personal.gitHubUrl" target="_blank" class="nav-social-icon" title="GitHub"><i class="fa-brands fa-github"></i></a>
                        }
                        @if (hasGitLab)
                        {
                            <a href="@personal.gitLabUrl" target="_blank" class="nav-social-icon" title="GitLab"><i class="fa-brands fa-gitlab"></i></a>
                        }
                        @if (hasScholar)
                        {
                            <a href="@personal.googleScholarUrl" target="_blank" class="nav-social-icon" title="Google Scholar"><i class="fa-solid fa-graduation-cap"></i></a>
                        }
                        @if (hasOrcid)
                        {
                            <a href="@personal.orcidUrl" target="_blank" class="nav-social-icon" title="ORCID"><i class="fa-brands fa-orcid"></i></a>
                        }
                    </div>
                }
                @if (hasContactSection)
                {
                    <a href="#contact" class="btn-gradient d-none d-sm-inline-flex">
                        <i class="fa-solid fa-paper-plane"></i> Contact
                    </a>
                }
                <button class="btn btn-sm btn-glass d-lg-none" id="mobileNavToggle" aria-label="Toggle navigation">
                    <i class="fa-solid fa-bars"></i>
                </button>
            </div>
        </div>
    </nav>

    <!-- Hero Section -->
    <section id="hero" class="hero-section">
        <div class="container">
            <!-- Top Right Connect Bar -->
            @if (hasAnySocial)
            {
                <div class="d-flex justify-content-end mb-4" data-aos="fade-down" data-aos-duration="600">
                    <div class="hero-top-connect">
                        <span class="text-muted small font-mono me-1"><i class="fa-solid fa-link text-primary me-1"></i>Connect:</span>
                        @if (hasLinkedIn)
                        {
                            <a href="@personal.linkedInUrl" target="_blank" class="social-link-sm" title="LinkedIn"><i class="fa-brands fa-linkedin-in"></i></a>
                        }
                        @if (hasGitHub)
                        {
                            <a href="@personal.gitHubUrl" target="_blank" class="social-link-sm" title="GitHub"><i class="fa-brands fa-github"></i></a>
                        }
                        @if (hasGitLab)
                        {
                            <a href="@personal.gitLabUrl" target="_blank" class="social-link-sm" title="GitLab"><i class="fa-brands fa-gitlab"></i></a>
                        }
                        @if (hasScholar)
                        {
                            <a href="@personal.googleScholarUrl" target="_blank" class="social-link-sm" title="Google Scholar"><i class="fa-solid fa-graduation-cap"></i></a>
                        }
                        @if (hasOrcid)
                        {
                            <a href="@personal.orcidUrl" target="_blank" class="social-link-sm" title="ORCID Profile"><i class="fa-brands fa-orcid"></i></a>
                        }
                        @if (hasEmail)
                        {
                            <a href="mailto:@personal.email" class="social-link-sm" title="Email"><i class="fa-solid fa-envelope"></i></a>
                        }
                        @if (hasMobile)
                        {
                            <a href="tel:@personal.mobileNumber" class="social-link-sm" title="Phone"><i class="fa-solid fa-phone"></i></a>
                        }
                    </div>
                </div>
            }

            <div class="row align-items-center gy-5">
                <!-- Hero Left Info -->
                <div class="col-lg-7" data-aos="fade-up" data-aos-duration="900">
                    <h1 class="display-3 fw-bold mb-3">
                        @if (hasName)
                        {
                            <span>Hi, I'm <span class="text-gradient">@personal.name</span></span>
                        }
                        else
                        {
                            <span class="text-gradient">Portfolio Showcase</span>
                        }
                    </h1>

                    <!-- Badges Directly Below Name -->
                    <div class="d-flex flex-wrap gap-2 mb-3 align-items-center justify-content-center justify-content-lg-start">
                        <div class="badge-status-pill">
                            <span class="status-dot"></span>
                            <span>Available for Opportunities</span>
                        </div>
                        @if (hasLocation)
                        {
                            <span class="badge py-2 px-3 rounded-pill bg-surface-badge">
                                <i class="fa-solid fa-location-dot text-primary me-2"></i>@personal.location
                            </span>
                        }
                        @if (hasWorkDetails)
                        {
                            <span class="badge py-2 px-3 rounded-pill bg-surface-badge">
                                <i class="fa-solid fa-briefcase text-info me-2"></i>@personal.workDetails
                            </span>
                        }
                    </div>

                    @if (hasBio)
                    {
                        <h2 class="h3 fw-semibold text-gradient-purple mb-3">
                            @personal.bio
                        </h2>
                    }

                    @if (hasSummary)
                    {
                        <p class="lead text-muted mb-4" style="max-width: 600px; font-size: 1.05rem;">
                            @personal.professionalSummary
                        </p>
                    }

                    <!-- Call to Actions -->
                    <div class="d-flex flex-wrap gap-3 mb-2 justify-content-center justify-content-lg-start">
                        @if (hasProjectsSection)
                        {
                            <a href="#projects" class="btn-gradient">
                                <i class="fa-solid fa-shapes"></i> View Projects
                            </a>
                        }
                        @if (hasContactSection)
                        {
                            <a href="#contact" class="btn-glass">
                                <i class="fa-solid fa-id-card"></i> Contact & Card
                            </a>
                        }
                        @if (hasEmail)
                        {
                            <a href="mailto:@personal.email" class="btn-glass" title="Email Direct">
                                <i class="fa-solid fa-at"></i> Email Me
                            </a>
                        }
                    </div>
                </div>

                <!-- Hero Right: Avatar with Glow Ring -->
                <div class="col-lg-5" data-aos="zoom-in" data-aos-duration="1000">
                    <div class="avatar-wrapper">
                        <div class="avatar-glow"></div>
                        @if (!string.IsNullOrWhiteSpace(personal.profilePictureUrl))
                        {
                            <img src="@personal.profilePictureUrl" alt="@displayName" class="avatar-img" />
                        }
                        else
                        {
                            <div class="avatar-fallback">@initials</div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- About Section (Only displayed if summary or academic links exist) -->
    @if (hasAboutSection)
    {
        <section id="about" class="py-5">
            <div class="container py-4">
                <div class="text-center mb-5" data-aos="fade-up">
                    <div class="section-badge"><i class="fa-solid fa-user"></i> About</div>
                    <h2 class="display-5 fw-bold">Professional Overview</h2>
                </div>

                <div class="row gy-4 align-items-stretch justify-content-center">
                    @if (hasSummary && hasAcademic)
                    {
                        <!-- Two-column layout when both summary and academic profiles exist -->
                        <div class="col-lg-7" data-aos="fade-right">
                            <div class="glass-panel p-4 p-md-5 h-100">
                                <h3 class="h4 fw-bold mb-3 text-gradient">Summary</h3>
                                <p class="text-sub" style="font-size: 1.05rem; white-space: pre-line;">
                                    @personal.professionalSummary
                                </p>
                            </div>
                        </div>

                        <div class="col-lg-5" data-aos="fade-left">
                            <div class="glass-panel p-4 p-md-5 h-100 d-flex flex-column justify-content-between">
                                <div>
                                    <h3 class="h4 fw-bold mb-3 text-gradient-purple">Research & Scholar Profiles</h3>
                                    <div class="d-flex flex-column gap-3">
                                        @if (hasScholar)
                                        {
                                            <a href="@personal.googleScholarUrl" target="_blank" class="contact-item-box">
                                                <div class="contact-icon-box" style="background: linear-gradient(135deg, #4285F4 0%, #34A853 100%);">
                                                    <i class="fa-solid fa-graduation-cap"></i>
                                                </div>
                                                <div class="flex-grow-1">
                                                    <div class="fw-bold">Google Scholar Profile</div>
                                                    <div class="text-muted small">View Citations & Publications <i class="fa-solid fa-arrow-up-right-from-square ms-1"></i></div>
                                                </div>
                                            </a>
                                        }
                                        @if (hasOrcid)
                                        {
                                            <a href="@personal.orcidUrl" target="_blank" class="contact-item-box">
                                                <div class="contact-icon-box" style="background: linear-gradient(135deg, #A6CE39 0%, #2b8200 100%);">
                                                    <i class="fa-brands fa-orcid"></i>
                                                </div>
                                                <div class="flex-grow-1">
                                                    <div class="fw-bold">ORCID Researcher Record</div>
                                                    <div class="text-muted small">Verified Academic Profile <i class="fa-solid fa-arrow-up-right-from-square ms-1"></i></div>
                                                </div>
                                            </a>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                    else if (hasSummary)
                    {
                        <!-- Single full-width summary card -->
                        <div class="col-lg-10" data-aos="fade-up">
                            <div class="glass-panel p-4 p-md-5">
                                <h3 class="h4 fw-bold mb-3 text-gradient">Summary</h3>
                                <p class="text-sub" style="font-size: 1.05rem; white-space: pre-line;">
                                    @personal.professionalSummary
                                </p>
                            </div>
                        </div>
                    }
                    else if (hasAcademic)
                    {
                        <!-- Single academic profiles card -->
                        <div class="col-lg-8" data-aos="fade-up">
                            <div class="glass-panel p-4 p-md-5">
                                <h3 class="h4 fw-bold mb-4 text-gradient-purple text-center">Research & Scholarly Profiles</h3>
                                <div class="d-flex flex-column gap-3">
                                    @if (hasScholar)
                                    {
                                        <a href="@personal.googleScholarUrl" target="_blank" class="contact-item-box">
                                            <div class="contact-icon-box" style="background: linear-gradient(135deg, #4285F4 0%, #34A853 100%);">
                                                <i class="fa-solid fa-graduation-cap"></i>
                                            </div>
                                            <div class="flex-grow-1">
                                                <div class="fw-bold">Google Scholar Profile</div>
                                                <div class="text-muted small">View Citations & Publications <i class="fa-solid fa-arrow-up-right-from-square ms-1"></i></div>
                                            </div>
                                        </a>
                                    }
                                    @if (hasOrcid)
                                    {
                                        <a href="@personal.orcidUrl" target="_blank" class="contact-item-box">
                                            <div class="contact-icon-box" style="background: linear-gradient(135deg, #A6CE39 0%, #2b8200 100%);">
                                                <i class="fa-brands fa-orcid"></i>
                                            </div>
                                            <div class="flex-grow-1">
                                                <div class="fw-bold">ORCID Researcher Record</div>
                                                <div class="text-muted small">Verified Academic Profile <i class="fa-solid fa-arrow-up-right-from-square ms-1"></i></div>
                                            </div>
                                        </a>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                </div>

                <!-- Experience Data Metrics Strip (Positioned Directly Below Professional Overview) -->
                @if (hasAnyStats)
                {
                    <div class="mt-5 pt-4 border-top border-secondary border-opacity-25" data-aos="fade-up" data-aos-duration="800">
                        <div class="text-center mb-4">
                            <span class="badge py-2 px-3 rounded-pill font-mono small text-uppercase" style="background: rgba(99, 102, 241, 0.15); color: #a5b4fc; border: 1px solid rgba(99, 102, 241, 0.3);">
                                <i class="fa-solid fa-chart-line me-2"></i>Experience Data & Milestones
                            </span>
                        </div>
                        <div class="row g-3 justify-content-center">
                            @if (hasExpYears)
                            {
                                <div class="col-6 col-md-3">
                                    <div class="stat-card">
                                        <div class="stat-number">@expYears</div>
                                        <div class="stat-label">Years Experience</div>
                                    </div>
                                </div>
                            }
                            @if (hasProjectsCount)
                            {
                                <div class="col-6 col-md-3">
                                    <div class="stat-card">
                                        <div class="stat-number">@projectsCountStr</div>
                                        <div class="stat-label">Projects Completed</div>
                                    </div>
                                </div>
                            }
                            @if (hasCompaniesCount)
                            {
                                <div class="col-6 col-md-3">
                                    <div class="stat-card">
                                        <div class="stat-number">@companiesCountStr</div>
                                        <div class="stat-label">Companies / Clients</div>
                                    </div>
                                </div>
                            }
                            @if (hasCredentialsCount)
                            {
                                <div class="col-6 col-md-3">
                                    <div class="stat-card">
                                        <div class="stat-number">@credentialsCountStr</div>
                                        <div class="stat-label">Certs & Publications</div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>
        </section>
    }

    <!-- Work Experience Section (Only if experiences added) -->
    @if (hasExperienceSection)
    {
        <section id="experience" class="py-5">
            <div class="container py-4">
                <div class="text-center mb-5" data-aos="fade-up">
                    <div class="section-badge"><i class="fa-solid fa-briefcase"></i> Experience</div>
                    <h2 class="display-5 fw-bold">Work Experience</h2>
                </div>

                <div class="row justify-content-center">
                    <div class="col-lg-10">
                        <div class="timeline-container">
                            @foreach (var exp in experiences)
                            {
                                <div class="timeline-node @(exp.isCurrentlyWorking ? "current" : "")" data-aos="fade-up">
                                    <div class="timeline-dot"></div>
                                    <div class="glass-panel p-4">
                                        <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-2">
                                            <div>
                                                <h3 class="h5 fw-bold mb-1 text-white">@exp.jobTitle</h3>
                                                <div class="text-gradient fw-semibold">
                                                    @exp.company
                                                    @if (!string.IsNullOrWhiteSpace(exp.location))
                                                    {
                                                        <span class="text-muted fw-normal ms-2 small"><i class="fa-solid fa-location-dot me-1"></i>@exp.location</span>
                                                    }
                                                </div>
                                            </div>
                                            <div class="d-flex align-items-center gap-2">
                                                @if (exp.isCurrentlyWorking)
                                                {
                                                    <span class="badge rounded-pill" style="background: rgba(16, 185, 129, 0.15); color: #34d399; border: 1px solid rgba(16, 185, 129, 0.3);">
                                                        <span class="status-dot me-1"></span> Current
                                                    </span>
                                                }
                                                <span class="badge py-2 px-3 rounded-pill bg-dark border border-secondary border-opacity-25 font-mono text-muted">
                                                    @exp.startDate — @(exp.isCurrentlyWorking ? "Present" : exp.endDate)
                                                </span>
                                            </div>
                                        </div>

                                        @if (exp.responsibilitiesList != null && exp.responsibilitiesList.Count > 0)
                                        {
                                            <ul class="list-unstyled mt-3 mb-0 text-sub" style="font-size: 0.95rem;">
                                                @foreach (var resp in exp.responsibilitiesList)
                                                {
                                                    <li class="d-flex align-items-start gap-2 mb-2">
                                                        <i class="fa-solid fa-circle-check text-info mt-1 small"></i>
                                                        <span>@resp</span>
                                                    </li>
                                                }
                                            </ul>
                                        }
                                        else if (!string.IsNullOrWhiteSpace(exp.responsibilities))
                                        {
                                            <p class="text-sub mt-3 mb-0" style="white-space: pre-line;">@exp.responsibilities</p>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </section>
    }

    <!-- Technical Skills Section (Only if skills added) -->
    @if (hasSkillsSection)
    {
        <section id="skills" class="py-5">
            <div class="container py-4">
                <div class="text-center mb-5" data-aos="fade-up">
                    <div class="section-badge"><i class="fa-solid fa-microchip"></i> Capabilities</div>
                    <h2 class="display-5 fw-bold">Skills & Proficiencies</h2>
                </div>

                <div class="row g-3" id="skillsGrid">
                    @foreach (var skill in skills)
                    {
                        string levelClass = "badge-advanced";
                        string level = skill.proficiencyLevel?.ToLower() ?? "";

                        if (level.Contains("expert")) { levelClass = "badge-expert"; }
                        else if (level.Contains("advance")) { levelClass = "badge-advanced"; }
                        else if (level.Contains("inter")) { levelClass = "badge-intermediate"; }
                        else if (level.Contains("begin")) { levelClass = "badge-beginner"; }

                        <div class="col-sm-6 col-md-4 col-lg-3 skill-item" data-aos="fade-up">
                            <div class="skill-card">
                                <div class="d-flex align-items-center justify-content-between">
                                    <span class="fw-bold text-white">@skill.skillName</span>
                                    @if (!string.IsNullOrWhiteSpace(skill.proficiencyLevel))
                                    {
                                        <span class="skill-badge @levelClass">@skill.proficiencyLevel</span>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </section>
    }

    <!-- Featured Projects & CAD Section (Only if projects added) -->
    @if (hasProjectsSection)
    {
        <section id="projects" class="py-5">
            <div class="container py-4">
                <div class="text-center mb-5" data-aos="fade-up">
                    <div class="section-badge"><i class="fa-solid fa-shapes"></i> Portfolio</div>
                    <h2 class="display-5 fw-bold">Projects & Work</h2>

                    @if (allTags.Count > 0)
                    {
                        <div class="d-flex flex-wrap justify-content-center gap-2 mt-4" id="projectFilterContainer">
                            <button class="filter-btn active" data-filter="all">All</button>
                            @foreach (var tag in allTags)
                            {
                                <button class="filter-btn" data-filter="@tag.ToLower().Replace(" ", "-")">@tag</button>
                            }
                        </div>
                    }
                </div>

                <div class="row g-4" id="projectsGrid">
                    @foreach (var proj in projects)
                    {
                        bool hasCad = !string.IsNullOrWhiteSpace(proj.cadFilePath);
                        string tagClasses = string.Join(" ", (proj.tagsList ?? new List<string>()).Select(t => t.ToLower().Replace(" ", "-")));

                        <div class="col-md-6 col-lg-4 project-item @tagClasses" data-aos="fade-up">
                            <div class="project-card">
                                <div class="project-thumb-box">
                                    @if (!string.IsNullOrWhiteSpace(proj.productImageUrl))
                                    {
                                        <img src="@proj.productImageUrl" alt="@proj.projectTitle" class="project-img" loading="lazy" />
                                    }
                                    else
                                    {
                                        <div class="project-placeholder-icon">
                                            <i class="fa-solid @(hasCad ? "fa-cube" : "fa-layer-group")"></i>
                                        </div>
                                    }

                                    @if (hasCad)
                                    {
                                        <div class="cad-badge-floating">
                                            <i class="fa-solid fa-cube"></i> CAD Model
                                        </div>
                                    }
                                </div>

                                <div class="p-4 d-flex flex-column flex-grow-1 justify-content-between">
                                    <div>
                                        <div class="d-flex align-items-center justify-content-between gap-2 mb-2">
                                            <h3 class="h5 fw-bold text-white mb-0">@proj.projectTitle</h3>
                                            @if (!string.IsNullOrWhiteSpace(proj.startDate) || !string.IsNullOrWhiteSpace(proj.endDate))
                                            {
                                                <span class="badge py-1 px-2 rounded-pill bg-dark border border-secondary border-opacity-25 font-mono text-muted small">
                                                    <i class="fa-regular fa-calendar me-1"></i>@proj.startDate @(string.IsNullOrWhiteSpace(proj.endDate) ? "" : "— " + proj.endDate)
                                                </span>
                                            }
                                        </div>

                                        @if (!string.IsNullOrWhiteSpace(proj.clientName))
                                        {
                                            <div class="text-info small fw-semibold mb-2">
                                                <i class="fa-solid fa-briefcase me-1"></i>@proj.clientName
                                            </div>
                                        }

                                        @if (!string.IsNullOrWhiteSpace(proj.description))
                                        {
                                            <p class="text-muted small mb-3" style="line-height: 1.5;">
                                                @proj.description
                                            </p>
                                        }

                                        @if (proj.tagsList != null && proj.tagsList.Count > 0)
                                        {
                                            <div class="d-flex flex-wrap gap-1 mb-3">
                                                @foreach (var tag in proj.tagsList)
                                                {
                                                    <span class="tag-pill">#@tag</span>
                                                }
                                            </div>
                                        }
                                    </div>

                                    @if (hasCad)
                                    {
                                        <div class="pt-3 border-top border-secondary border-opacity-25 mt-3">
                                            <button class="btn btn-sm btn-gradient w-100 justify-content-center py-2 btn-preview-cad" 
                                                    data-title="@proj.projectTitle" 
                                                    data-cad="@proj.cadFilePath"
                                                    title="Launch 3D CAD Interactive Visualizer">
                                                <i class="fa-solid fa-cube me-2"></i> Launch 3D CAD Viewer
                                            </button>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </section>
    }

    <!-- Certifications & Publications Section (Only if added) -->
    @if (hasCertificationsSection || hasPublicationsSection)
    {
        <section id="certifications" class="py-5">
            <div class="container py-4">
                <div class="text-center mb-5" data-aos="fade-up">
                    <div class="section-badge"><i class="fa-solid fa-certificate"></i> Credentials</div>
                    <h2 class="display-5 fw-bold">Certifications & Research</h2>
                </div>

                @if (hasCertificationsSection)
                {
                    <h3 class="h4 fw-bold mb-4 text-white"><i class="fa-solid fa-award text-primary me-2"></i>Certifications</h3>
                    <div class="row g-4 mb-5">
                        @foreach (var cert in certifications)
                        {
                            <div class="col-md-6 col-lg-4" data-aos="fade-up">
                                <div class="credential-card">
                                    <div>
                                        <div class="d-flex align-items-center justify-content-between mb-3">
                                            <span class="badge rounded-pill" style="background: rgba(99, 102, 241, 0.18); color: #a5b4fc; border: 1px solid rgba(99, 102, 241, 0.3);">
                                                @(string.IsNullOrWhiteSpace(cert.type) ? "Certification" : cert.type)
                                            </span>
                                            @if (!string.IsNullOrWhiteSpace(cert.issueDate))
                                            {
                                                <span class="text-muted small font-mono"><i class="fa-regular fa-calendar me-1"></i>@cert.issueDate</span>
                                            }
                                        </div>

                                        <h4 class="h5 fw-bold text-white mb-1">@cert.name</h4>
                                        @if (!string.IsNullOrWhiteSpace(cert.issuer))
                                        {
                                            <div class="text-gradient fw-semibold small mb-3">@cert.issuer</div>
                                        }
                                    </div>

                                    @if (!string.IsNullOrWhiteSpace(cert.credentialLink))
                                    {
                                        <div class="pt-3 border-top border-secondary border-opacity-25 mt-3">
                                            <a href="@cert.credentialLink" target="_blank" class="btn btn-sm btn-glass w-100 justify-content-center">
                                                <i class="fa-solid fa-arrow-up-right-from-square me-1 text-primary"></i> Verify Credential
                                            </a>
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                }

                @if (hasPublicationsSection)
                {
                    <div id="publications" class="pt-3">
                        <h3 class="h4 fw-bold mb-4 text-white"><i class="fa-solid fa-book-bookmark text-info me-2"></i>Publications</h3>
                        <div class="row g-4">
                            @foreach (var pub in publications)
                            {
                                <div class="col-md-6" data-aos="fade-up">
                                    <div class="glass-panel p-4 d-flex align-items-start gap-3 h-100">
                                        <div class="pub-paper-badge">
                                            <i class="fa-solid fa-file-lines"></i>
                                        </div>
                                        <div class="flex-grow-1">
                                            <h4 class="h6 fw-bold text-white mb-1">@pub.title</h4>
                                            @if (!string.IsNullOrWhiteSpace(pub.publisher) || !string.IsNullOrWhiteSpace(pub.publicationDate))
                                            {
                                                <div class="text-info small mb-2">
                                                    @if (!string.IsNullOrWhiteSpace(pub.publisher))
                                                    {
                                                        <i class="fa-solid fa-building-columns me-1"></i>@pub.publisher
                                                    }
                                                    @if (!string.IsNullOrWhiteSpace(pub.publicationDate))
                                                    {
                                                        <span class="text-muted ms-2">(@pub.publicationDate)</span>
                                                    }
                                                </div>
                                            }

                                            @if (!string.IsNullOrWhiteSpace(pub.abstractText))
                                            {
                                                <div class="my-2 p-3 rounded" style="background: rgba(255,255,255,0.03); border-left: 3px solid var(--secondary); font-size: 0.88rem; line-height: 1.6; color: var(--text-sub);">
                                                    <strong class="text-white d-block mb-1" style="font-size: 0.78rem; letter-spacing: 0.05em; text-transform: uppercase;"><i class="fa-solid fa-align-left me-1 text-info"></i> Abstract</strong>
                                                    @pub.abstractText
                                                </div>
                                            }

                                            @if (!string.IsNullOrWhiteSpace(pub.publicationLink))
                                            {
                                                <div class="mt-2">
                                                    <a href="@pub.publicationLink" target="_blank" class="text-gradient small text-decoration-none fw-semibold">
                                                        Read Publication <i class="fa-solid fa-arrow-up-right-from-square ms-1"></i>
                                                    </a>
                                                </div>
                                            }
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>
        </section>
    }

    <!-- Contact Section (Digital Business Card & Direct Messaging) -->
    @if (hasContactSection)
    {
        <section id="contact" class="py-5">
            <div class="container py-4">
                <div class="text-center mb-5" data-aos="fade-up">
                    <div class="section-badge"><i class="fa-solid fa-id-card"></i> Contact</div>
                    <h2 class="display-5 fw-bold">Executive Contact & Business Card</h2>
                </div>

                <div class="row gy-4 align-items-stretch justify-content-center">
                    <!-- Left Column: Interactive Executive Digital Business Card -->
                    <div class="col-lg-5" data-aos="fade-right">
                        <div class="business-card-wrapper h-100 d-flex flex-column justify-content-center">
                            <div class="business-card" id="executiveBusinessCard">
                                <div class="business-card-hologram"></div>
                                
                                <!-- Card Header: Chip, Contactless NFC, Verified Badge -->
                                <div class="d-flex align-items-center justify-content-between mb-4">
                                    <div class="d-flex align-items-center gap-3">
                                        <div class="business-card-chip">
                                            <div class="business-card-chip-lines"></div>
                                        </div>
                                        <i class="fa-solid fa-wifi fa-rotate-90 text-warning opacity-75 fs-5" title="Contactless Digital Card"></i>
                                    </div>
                                    <span class="badge py-1 px-3 rounded-pill" style="background: rgba(6, 182, 212, 0.15); color: #67e8f9; border: 1px solid rgba(6, 182, 212, 0.3); font-size: 0.72rem; letter-spacing: 0.08em; text-transform: uppercase;">
                                        <i class="fa-solid fa-circle-check me-1"></i> Verified Profile
                                    </span>
                                </div>

                                <!-- Card Identity -->
                                <div class="d-flex align-items-center gap-3 mb-4">
                                    <div class="avatar-wrapper m-0" style="width: 64px; height: 64px; flex-shrink: 0;">
                                        @if (!string.IsNullOrWhiteSpace(personal.profilePictureUrl))
                                        {
                                            <img src="@personal.profilePictureUrl" alt="@displayName" class="avatar-img" style="border-width: 2px;" />
                                        }
                                        else
                                        {
                                            <div class="avatar-fallback" style="font-size: 1.5rem; border-width: 2px;">@initials</div>
                                        }
                                    </div>
                                    <div>
                                        <h3 class="business-card-name">@displayName</h3>
                                        <div class="business-card-title">@(hasBio ? personal.bio : "Professional Portfolio")</div>
                                        @if (hasWorkDetails)
                                        {
                                            <div class="business-card-org"><i class="fa-solid fa-briefcase me-1 text-muted"></i>@personal.workDetails</div>
                                        }
                                    </div>
                                </div>

                                <!-- Card Contact Details List -->
                                <div class="d-flex flex-column gap-2 mb-4">
                                    @if (hasEmail)
                                    {
                                        <a href="mailto:@personal.email" class="business-card-item" title="Click to email">
                                            <i class="fa-solid fa-envelope"></i>
                                            <span class="text-truncate">@personal.email</span>
                                        </a>
                                    }
                                    @if (hasMobile)
                                    {
                                        <a href="tel:@personal.mobileNumber" class="business-card-item" title="Click to call">
                                            <i class="fa-solid fa-phone"></i>
                                            <span>@personal.mobileNumber</span>
                                        </a>
                                    }
                                    @if (hasLocation)
                                    {
                                        <div class="business-card-item">
                                            <i class="fa-solid fa-location-dot"></i>
                                            <span>@personal.location</span>
                                        </div>
                                    }
                                </div>

                                <!-- Card Footer: Quick Actions & Social Icons -->
                                <div class="pt-3 border-top border-secondary border-opacity-25 d-flex flex-wrap align-items-center justify-content-between gap-2">
                                    <div class="d-flex align-items-center gap-1">
                                        @if (hasLinkedIn)
                                        {
                                            <a href="@personal.linkedInUrl" target="_blank" class="social-link-sm" title="LinkedIn"><i class="fa-brands fa-linkedin-in"></i></a>
                                        }
                                        @if (hasGitHub)
                                        {
                                            <a href="@personal.gitHubUrl" target="_blank" class="social-link-sm" title="GitHub"><i class="fa-brands fa-github"></i></a>
                                        }
                                        @if (hasScholar)
                                        {
                                            <a href="@personal.googleScholarUrl" target="_blank" class="social-link-sm" title="Scholar"><i class="fa-solid fa-graduation-cap"></i></a>
                                        }
                                        @if (hasOrcid)
                                        {
                                            <a href="@personal.orcidUrl" target="_blank" class="social-link-sm" title="ORCID"><i class="fa-brands fa-orcid"></i></a>
                                        }
                                    </div>
                                    <button type="button" class="btn-card-action" onclick="copyContactInfo()">
                                        <i class="fa-regular fa-copy"></i> <span id="copyBtnText">Copy Contact</span>
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Right Column: Send a Message Form -->
                    <div class="col-lg-7" data-aos="fade-left">
                        <div class="glass-panel p-4 p-md-5 h-100">
                            <h3 class="h4 fw-bold text-white mb-2">Send a Direct Message</h3>
                            <p class="text-muted small mb-4">Have an opportunity or inquiry? Send a direct message below.</p>

                            <form id="contactForm">
                                <div class="row g-3 mb-3">
                                    <div class="col-md-6">
                                        <label class="form-label text-muted small fw-semibold">Your Name *</label>
                                        <input type="text" id="contactName" class="form-control form-control-glass" placeholder="Your Name" required />
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label text-muted small fw-semibold">Your Email *</label>
                                        <input type="email" id="contactEmail" class="form-control form-control-glass" placeholder="Your Email" required />
                                    </div>
                                </div>
                                <div class="mb-3">
                                    <label class="form-label text-muted small fw-semibold">Subject</label>
                                    <input type="text" id="contactSubject" class="form-control form-control-glass" placeholder="Subject" />
                                </div>
                                <div class="mb-4">
                                    <label class="form-label text-muted small fw-semibold">Message *</label>
                                    <textarea id="contactMessage" rows="4" class="form-control form-control-glass" placeholder="Write your message here..." required></textarea>
                                </div>
                                <button type="submit" class="btn-gradient w-100 justify-content-center py-3">
                                    <i class="fa-solid fa-paper-plane me-2"></i> Send Message
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    }

    <!-- 3D CAD Preview Interactive Modal -->
    <div class="modal fade" id="cadModal" tabindex="-1" aria-labelledby="cadModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content glass-panel" style="background: rgba(15, 23, 42, 0.95); border: 1px solid rgba(255,255,255,0.15);">
                <div class="modal-header border-bottom border-secondary border-opacity-25 pb-3">
                    <div class="d-flex align-items-center gap-2">
                        <div class="nav-logo-badge" style="width: 32px; height: 32px; font-size: 0.8rem;"><i class="fa-solid fa-cube"></i></div>
                        <h5 class="modal-title fw-bold text-white mb-0" id="cadModalTitle">3D CAD Model Visualizer</h5>
                    </div>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-3">
                    <div id="cadViewerContainer">
                        <canvas id="cadCanvas"></canvas>

                        <!-- Model HUD Status Indicator -->
                        <div id="cadModelHud" class="cad-model-hud">
                            <i class="fa-solid fa-cube text-info"></i>
                            <span id="cadHudText">Loading CAD Model...</span>
                        </div>

                        <!-- CAD Interactive Loading Overlay -->
                        <div id="cadLoadingOverlay" class="cad-loading-overlay d-none">
                            <div class="spinner-border text-info" role="status"></div>
                            <span id="cadLoadingText" class="font-mono small">Processing Geometry...</span>
                        </div>

                        <!-- Interactive 3D Control Toolbar -->
                        <div class="cad-toolbar">
                            <button class="cad-btn-tool" id="btnToggleRotate" title="Toggle Auto-Rotate">
                                <i class="fa-solid fa-arrows-rotate"></i> Rotate
                            </button>
                            <button class="cad-btn-tool" id="btnToggleWireframe" title="Toggle Wireframe">
                                <i class="fa-solid fa-network-wired"></i> Wireframe
                            </button>
                            <button class="cad-btn-tool" id="btnToggleMaterial" title="Toggle Shading Finish">
                                <i class="fa-solid fa-palette"></i> Shading
                            </button>
                            <button class="cad-btn-tool" id="btnResetView" title="Reset Camera">
                                <i class="fa-solid fa-camera"></i> Reset
                            </button>
                        </div>
                    </div>
                    <div class="d-flex flex-wrap justify-content-between align-items-center mt-3 px-2 gap-2">
                        <span class="text-muted small"><i class="fa-solid fa-hand-pointer me-1 text-info"></i> Orbit: Left-click & drag • Zoom: Scroll • Pan: Right-click & drag</span>
                        <span class="badge bg-dark border border-secondary border-opacity-25 text-info font-mono small py-2 px-3">
                            <i class="fa-solid fa-microchip me-1"></i> WebGL 3D Interactive
                        </span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Portfolio Footer -->
    <footer class="portfolio-footer">
        <div class="container">
            <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
                <div class="d-flex align-items-center gap-2">
                    <div class="nav-logo-badge" style="width: 30px; height: 30px; font-size: 0.8rem;">@initials</div>
                    <span class="fw-bold text-white">@displayName</span>
                    <span class="text-muted small ms-2">© @DateTime.Now.Year. All rights reserved.</span>
                </div>

                <div class="d-flex align-items-center gap-3">
                    <a href="#hero" class="btn-top" title="Back to top">
                        <i class="fa-solid fa-arrow-up"></i>
                    </a>
                </div>
            </div>
        </div>
    </footer>

    <!-- Scripts: Bootstrap, Three.js, Loaders, AOS -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/aos/2.3.4/aos.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/three@0.128.0/examples/js/controls/OrbitControls.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/three@0.128.0/examples/js/loaders/STLLoader.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/three@0.128.0/examples/js/loaders/OBJLoader.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/three@0.128.0/examples/js/loaders/GLTFLoader.js"></script>

    <script>
        // Initialize AOS animations
        AOS.init({
            duration: 800,
            once: true,
            easing: 'ease-out-cubic'
        });

        // Sticky Navbar scroll effect
        window.addEventListener('scroll', () => {
            const nav = document.getElementById('mainNav');
            if (window.scrollY > 40) {
                nav.classList.add('scrolled');
            } else {
                nav.classList.remove('scrolled');
            }
        });

        // Mobile Nav Toggle
        document.getElementById('mobileNavToggle')?.addEventListener('click', () => {
            document.getElementById('navLinksList').classList.toggle('mobile-open');
        });

        // Close mobile nav on click
        document.querySelectorAll('.nav-link-custom').forEach(link => {
            link.addEventListener('click', () => {
                document.getElementById('navLinksList').classList.remove('mobile-open');
            });
        });

        // Projects Tag Filter
        document.querySelectorAll('#projectFilterContainer .filter-btn').forEach(btn => {
            btn.addEventListener('click', function() {
                document.querySelectorAll('#projectFilterContainer .filter-btn').forEach(b => b.classList.remove('active'));
                this.classList.add('active');
                const filter = this.getAttribute('data-filter');

                document.querySelectorAll('.project-item').forEach(item => {
                    if (filter === 'all' || item.classList.contains(filter)) {
                        item.style.display = 'block';
                    } else {
                        item.style.display = 'none';
                    }
                });
            });
        });

        // Interactive Three.js Background Ambient Particle Mesh
        (function initBackgroundCanvas() {
            const canvas = document.getElementById('bgCanvas');
            if (!canvas) return;

            const ctx = canvas.getContext('2d');
            let width, height;
            let particles = [];
            const particleCount = 40;

            function resize() {
                width = canvas.width = window.innerWidth;
                height = canvas.height = window.innerHeight;
            }
            window.addEventListener('resize', resize);
            resize();

            for (let i = 0; i < particleCount; i++) {
                particles.push({
                    x: Math.random() * width,
                    y: Math.random() * height,
                    vx: (Math.random() - 0.5) * 0.4,
                    vy: (Math.random() - 0.5) * 0.4,
                    size: Math.random() * 2 + 1,
                    alpha: Math.random() * 0.4 + 0.15
                });
            }

            function animate() {
                ctx.clearRect(0, 0, width, height);

                for (let i = 0; i < particles.length; i++) {
                    let p = particles[i];
                    p.x += p.vx;
                    p.y += p.vy;

                    if (p.x < 0) p.x = width;
                    if (p.x > width) p.x = 0;
                    if (p.y < 0) p.y = height;
                    if (p.y > height) p.y = 0;

                    ctx.fillStyle = `rgba(99, 102, 241, ${p.alpha})`;
                    ctx.beginPath();
                    ctx.arc(p.x, p.y, p.size, 0, Math.PI * 2);
                    ctx.fill();

                    for (let j = i + 1; j < particles.length; j++) {
                        let p2 = particles[j];
                        let dx = p.x - p2.x;
                        let dy = p.y - p2.y;
                        let dist = Math.sqrt(dx * dx + dy * dy);
                        if (dist < 130) {
                            ctx.strokeStyle = `rgba(99, 102, 241, ${(1 - dist / 130) * 0.12})`;
                            ctx.lineWidth = 0.8;
                            ctx.beginPath();
                            ctx.moveTo(p.x, p.y);
                            ctx.lineTo(p2.x, p2.y);
                            ctx.stroke();
                        }
                    }
                }
                requestAnimationFrame(animate);
            }
            animate();
        })();

        // Three.js 3D CAD Preview Engine (Dynamic Loader with Procedural Engineering Fallback)
        let cadScene, cadCamera, cadRenderer, cadControls, cadMeshGroup, isRotating = true;
        let animationFrameId;
        let isClayMaterial = false;
        let currentCadMaterial;

        function initCadViewerBase() {
            const container = document.getElementById('cadViewerContainer');
            const canvas = document.getElementById('cadCanvas');
            if (!container || !canvas || cadRenderer) return;

            const rect = container.getBoundingClientRect();
            cadScene = new THREE.Scene();
            cadScene.background = new THREE.Color(0x0a0f1d);

            cadCamera = new THREE.PerspectiveCamera(45, rect.width / rect.height, 0.1, 1000);
            cadCamera.position.set(4, 3, 5);

            cadRenderer = new THREE.WebGLRenderer({ canvas: canvas, antialias: true, alpha: true });
            cadRenderer.setSize(rect.width, rect.height);
            cadRenderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));

            const ambientLight = new THREE.AmbientLight(0xffffff, 0.75);
            cadScene.add(ambientLight);

            const dirLight1 = new THREE.DirectionalLight(0x06b6d4, 1.4);
            dirLight1.position.set(6, 12, 8);
            cadScene.add(dirLight1);

            const dirLight2 = new THREE.DirectionalLight(0x6366f1, 0.9);
            dirLight2.position.set(-8, -6, -6);
            cadScene.add(dirLight2);

            const gridHelper = new THREE.GridHelper(12, 24, 0x6366f1, 0x1e293b);
            gridHelper.position.y = -1.2;
            cadScene.add(gridHelper);

            cadControls = new THREE.OrbitControls(cadCamera, cadRenderer.domElement);
            cadControls.enableDamping = true;
            cadControls.dampingFactor = 0.05;

            function renderCad() {
                animationFrameId = requestAnimationFrame(renderCad);
                if (isRotating && cadMeshGroup) {
                    cadMeshGroup.rotation.y += 0.007;
                }
                cadControls.update();
                cadRenderer.render(cadScene, cadCamera);
            }
            renderCad();

            window.addEventListener('resize', () => {
                if (!container || !cadRenderer) return;
                const r = container.getBoundingClientRect();
                cadCamera.aspect = r.width / r.height;
                cadCamera.updateProjectionMatrix();
                cadRenderer.setSize(r.width, r.height);
            });
        }

        // Procedural Engineering CAD Model (High-Precision Multi-Vane Turbine Impeller)
        function createProceduralEngineeringModel() {
            const group = new THREE.Group();

            const mat = new THREE.MeshStandardMaterial({
                color: 0x06b6d4,
                metalness: 0.85,
                roughness: 0.22,
                wireframe: false
            });
            currentCadMaterial = mat;

            // 1. Central Rotor Hub with tapered mechanical bore
            const hubGeo = new THREE.CylinderGeometry(0.55, 0.8, 1.0, 32);
            const hub = new THREE.Mesh(hubGeo, mat);
            group.add(hub);

            // 2. Central Bore & Shaft Collar
            const collarGeo = new THREE.CylinderGeometry(0.32, 0.32, 1.25, 32);
            const collarMat = new THREE.MeshStandardMaterial({
                color: 0x818cf8,
                metalness: 0.9,
                roughness: 0.2
            });
            const collar = new THREE.Mesh(collarGeo, collarMat);
            group.add(collar);

            // 3. 10 Aerodynamic Curved Turbine Vanes
            const bladeCount = 10;
            for (let i = 0; i < bladeCount; i++) {
                const angle = (i / bladeCount) * Math.PI * 2;
                const bladeGeo = new THREE.BoxGeometry(0.1, 0.75, 1.3);
                const blade = new THREE.Mesh(bladeGeo, mat);
                blade.position.set(Math.cos(angle) * 1.05, 0, Math.sin(angle) * 1.05);
                blade.rotation.y = -angle + 0.5;
                blade.rotation.x = 0.35;
                group.add(blade);
            }

            // 4. Outer Shroud Retention Ring
            const ringGeo = new THREE.TorusGeometry(1.7, 0.08, 16, 64);
            const ring = new THREE.Mesh(ringGeo, mat);
            ring.rotation.x = Math.PI / 2;
            group.add(ring);

            return group;
        }

        function clearCadModel() {
            if (cadMeshGroup && cadScene) {
                cadScene.remove(cadMeshGroup);
                cadMeshGroup.traverse(child => {
                    if (child.isMesh) {
                        child.geometry?.dispose();
                        if (Array.isArray(child.material)) child.material.forEach(m => m.dispose());
                        else child.material?.dispose();
                    }
                });
                cadMeshGroup = null;
            }
        }

        function loadCadModel(cadPath, title) {
            initCadViewerBase();
            clearCadModel();

            const hudText = document.getElementById('cadHudText');
            const overlay = document.getElementById('cadLoadingOverlay');
            const loadingText = document.getElementById('cadLoadingText');

            function showLoader(txt) {
                if (overlay) {
                    overlay.classList.remove('d-none');
                    if (loadingText) loadingText.textContent = txt || 'Loading CAD Geometry...';
                }
            }

            function hideLoader() {
                if (overlay) overlay.classList.add('d-none');
            }

            const cleanPath = (cadPath || '').trim();
            const lowerPath = cleanPath.toLowerCase();

            function fitCameraToMesh(obj) {
                const box = new THREE.Box3().setFromObject(obj);
                const size = box.getSize(new THREE.Vector3());
                const center = box.getCenter(new THREE.Vector3());
                const maxDim = Math.max(size.x, size.y, size.z) || 2;
                const fov = cadCamera.fov * (Math.PI / 180);
                let cameraZ = Math.abs(maxDim / 2 / Math.tan(fov / 2)) * 1.6;
                cadCamera.position.set(center.x + cameraZ * 0.7, center.y + cameraZ * 0.5, center.z + cameraZ * 0.9);
                cadCamera.lookAt(center);
                cadControls.target.copy(center);
                cadControls.update();
            }

            // Fallback to Procedural Engineering Turbine
            function fallbackToEngineeringModel() {
                hideLoader();
                cadMeshGroup = createProceduralEngineeringModel();
                cadScene.add(cadMeshGroup);
                if (hudText) hudText.textContent = title + ' • Mechanical Impeller CAD Simulation';
                cadCamera.position.set(3, 2.5, 4);
                cadControls.target.set(0, 0, 0);
                cadControls.update();
            }

            if (!cleanPath || cleanPath === '#' || cleanPath === '/') {
                fallbackToEngineeringModel();
                return;
            }

            showLoader('Fetching ' + cleanPath.split('/').pop() + '...');

            const standardCadMaterial = new THREE.MeshStandardMaterial({
                color: 0x06b6d4,
                metalness: 0.85,
                roughness: 0.22
            });
            currentCadMaterial = standardCadMaterial;

            if (lowerPath.endsWith('.stl') && window.THREE && THREE.STLLoader) {
                const loader = new THREE.STLLoader();
                loader.load(cleanPath, function (geometry) {
                    hideLoader();
                    geometry.computeVertexNormals();
                    geometry.center();
                    const mesh = new THREE.Mesh(geometry, standardCadMaterial);
                    cadMeshGroup = new THREE.Group();
                    cadMeshGroup.add(mesh);
                    cadScene.add(cadMeshGroup);
                    fitCameraToMesh(cadMeshGroup);
                    if (hudText) hudText.textContent = title + ' • STL Solid Model';
                }, undefined, function (err) {
                    console.warn('Could not load STL, falling back to procedural CAD simulation:', err);
                    fallbackToEngineeringModel();
                });
            } else if (lowerPath.endsWith('.obj') && window.THREE && THREE.OBJLoader) {
                const loader = new THREE.OBJLoader();
                loader.load(cleanPath, function (obj) {
                    hideLoader();
                    obj.traverse(child => {
                        if (child.isMesh) child.material = standardCadMaterial;
                    });
                    cadMeshGroup = obj;
                    cadScene.add(cadMeshGroup);
                    fitCameraToMesh(cadMeshGroup);
                    if (hudText) hudText.textContent = title + ' • OBJ 3D Model';
                }, undefined, function (err) {
                    console.warn('Could not load OBJ, falling back to procedural CAD simulation:', err);
                    fallbackToEngineeringModel();
                });
            } else if ((lowerPath.endsWith('.gltf') || lowerPath.endsWith('.glb')) && window.THREE && THREE.GLTFLoader) {
                const loader = new THREE.GLTFLoader();
                loader.load(cleanPath, function (gltf) {
                    hideLoader();
                    cadMeshGroup = gltf.scene || gltf.scenes[0];
                    cadScene.add(cadMeshGroup);
                    fitCameraToMesh(cadMeshGroup);
                    if (hudText) hudText.textContent = title + ' • glTF CAD Scene';
                }, undefined, function (err) {
                    console.warn('Could not load GLTF, falling back to procedural CAD simulation:', err);
                    fallbackToEngineeringModel();
                });
            } else {
                fallbackToEngineeringModel();
            }
        }

        document.querySelectorAll('.btn-preview-cad').forEach(btn => {
            btn.addEventListener('click', function() {
                const title = this.getAttribute('data-title') || 'CAD Model Preview';
                const cadPath = this.getAttribute('data-cad') || '';

                document.getElementById('cadModalTitle').textContent = title + ' — 3D Viewer';

                const modal = new bootstrap.Modal(document.getElementById('cadModal'));
                modal.show();

                setTimeout(() => {
                    loadCadModel(cadPath, title);
                    if (cadRenderer) {
                        const container = document.getElementById('cadViewerContainer');
                        const r = container.getBoundingClientRect();
                        cadCamera.aspect = r.width / r.height;
                        cadCamera.updateProjectionMatrix();
                        cadRenderer.setSize(r.width, r.height);
                    }
                }, 250);
            });
        });

        document.getElementById('btnToggleRotate')?.addEventListener('click', function() {
            isRotating = !isRotating;
            this.classList.toggle('active', isRotating);
        });

        document.getElementById('btnToggleWireframe')?.addEventListener('click', function() {
            if (cadMeshGroup) {
                let wire = false;
                cadMeshGroup.traverse(child => {
                    if (child.isMesh && child.material) {
                        child.material.wireframe = !child.material.wireframe;
                        wire = child.material.wireframe;
                    }
                });
                this.classList.toggle('active', wire);
            }
        });

        document.getElementById('btnToggleMaterial')?.addEventListener('click', function() {
            isClayMaterial = !isClayMaterial;
            this.classList.toggle('active', isClayMaterial);
            if (cadMeshGroup) {
                cadMeshGroup.traverse(child => {
                    if (child.isMesh && child.material) {
                        if (isClayMaterial) {
                            child.material.color = new THREE.Color(0xf1f5f9);
                            child.material.metalness = 0.05;
                            child.material.roughness = 0.8;
                        } else {
                            child.material.color = new THREE.Color(0x06b6d4);
                            child.material.metalness = 0.85;
                            child.material.roughness = 0.22;
                        }
                    }
                });
            }
        });

        document.getElementById('btnResetView')?.addEventListener('click', function() {
            if (cadCamera && cadControls) {
                cadCamera.position.set(4, 3, 5);
                cadControls.target.set(0, 0, 0);
                cadControls.update();
            }
        });

        // Copy Contact Information Function for Business Card
        function copyContactInfo() {
            const name = '@displayName';
            const email = '@(hasEmail ? personal.email : "")';
            const phone = '@(hasMobile ? personal.mobileNumber : "")';
            const location = '@(hasLocation ? personal.location : "")';
            
            const contactText = `${name}\nEmail: ${email}\nPhone: ${phone}\nLocation: ${location}`;
            navigator.clipboard.writeText(contactText).then(() => {
                const btn = document.getElementById('copyBtnText');
                if (btn) {
                    btn.textContent = 'Copied!';
                    setTimeout(() => { btn.textContent = 'Copy Contact'; }, 2500);
                }
            }).catch(() => {
                alert('Contact details:\n' + contactText);
            });
        }

        // Interactive 3D Business Card Tilt Effect
        const businessCard = document.getElementById('executiveBusinessCard');
        if (businessCard) {
            businessCard.addEventListener('mousemove', function (e) {
                const rect = businessCard.getBoundingClientRect();
                const x = e.clientX - rect.left;
                const y = e.clientY - rect.top;
                const centerX = rect.width / 2;
                const centerY = rect.height / 2;
                const rotateX = ((y - centerY) / centerY) * -10;
                const rotateY = ((x - centerX) / centerX) * 12;
                businessCard.style.transform = `perspective(1000px) rotateX(${rotateX}deg) rotateY(${rotateY}deg) scale3d(1.02, 1.02, 1.02)`;
            });

            businessCard.addEventListener('mouseleave', function () {
                businessCard.style.transform = 'perspective(1000px) rotateX(0deg) rotateY(0deg) scale3d(1, 1, 1)';
            });
        }

        // Contact Form Handling (Uses real personal email when available)
        document.getElementById('contactForm')?.addEventListener('submit', function(e) {
            e.preventDefault();
            const name = document.getElementById('contactName').value;
            const email = document.getElementById('contactEmail').value;
            const subject = document.getElementById('contactSubject').value || 'Portfolio Contact Inquiry';
            const message = document.getElementById('contactMessage').value;

            const targetEmail = '@(hasEmail ? personal.email : "")';
            if (targetEmail) {
                const mailtoUrl = `mailto:${targetEmail}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent("Name: " + name + "\nEmail: " + email + "\n\nMessage:\n" + message)}`;
                window.location.href = mailtoUrl;
                alert("Thank you! Your email client has been opened with your inquiry.");
            } else {
                alert("Thank you for your message, " + name + "! Message captured.");
            }
            this.reset();
        });
    </script>
</body>
</html>
