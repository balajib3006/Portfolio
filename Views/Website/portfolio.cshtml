    <!-- Scripts: Bootstrap, Three.js, AOS -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/aos/2.3.4/aos.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/three@0.128.0/examples/js/controls/OrbitControls.js"></script>

    <script>
        // Initialize AOS animations
        AOS.init({
            duration: 800,
            once: true,
            easing: 'ease-out-cubic'
        });

        // Sticky Navbar scroll effect
        window.addEventListener('scroll', () => {
            const nav = document.getElementById('mainNav');
            if (window.scrollY > 40) {
                nav.classList.add('scrolled');
            } else {
                nav.classList.remove('scrolled');
            }
        });

        // Mobile Nav Toggle
        document.getElementById('mobileNavToggle')?.addEventListener('click', () => {
            document.getElementById('navLinksList').classList.toggle('mobile-open');
        });

        // Close mobile nav on click
        document.querySelectorAll('.nav-link-custom').forEach(link => {
            link.addEventListener('click', () => {
                document.getElementById('navLinksList').classList.remove('mobile-open');
            });
        });

        // Skills Category Filter
        document.querySelectorAll('#skillFilterContainer .filter-btn').forEach(btn => {
            btn.addEventListener('click', function() {
                document.querySelectorAll('#skillFilterContainer .filter-btn').forEach(b => b.classList.remove('active'));
                this.classList.add('active');
                const filter = this.getAttribute('data-filter');

                document.querySelectorAll('.skill-item').forEach(item => {
                    if (filter === 'all' || item.classList.contains(filter)) {
                        item.style.display = 'block';
                    } else {
                        item.style.display = 'none';
                    }
                });
            });
        });

        // Projects Tag Filter
        document.querySelectorAll('#projectFilterContainer .filter-btn').forEach(btn => {
            btn.addEventListener('click', function() {
                document.querySelectorAll('#projectFilterContainer .filter-btn').forEach(b => b.classList.remove('active'));
                this.classList.add('active');
                const filter = this.getAttribute('data-filter');

                document.querySelectorAll('.project-item').forEach(item => {
                    if (filter === 'all' || item.classList.contains(filter)) {
                        item.style.display = 'block';
                    } else {
                        item.style.display = 'none';
                    }
                });
            });
        });

        // Interactive Three.js Background Ambient Particle Mesh
        (function initBackgroundCanvas() {
            const canvas = document.getElementById('bgCanvas');
            if (!canvas) return;

            const ctx = canvas.getContext('2d');
            let width, height;
            let particles = [];
            const particleCount = 45;

            function resize() {
                width = canvas.width = window.innerWidth;
                height = canvas.height = window.innerHeight;
            }
            window.addEventListener('resize', resize);
            resize();

            for (let i = 0; i < particleCount; i++) {
                particles.push({
                    x: Math.random() * width,
                    y: Math.random() * height,
                    vx: (Math.random() - 0.5) * 0.4,
                    vy: (Math.random() - 0.5) * 0.4,
                    size: Math.random() * 2 + 1,
                    alpha: Math.random() * 0.5 + 0.2
                });
            }

            function animate() {
                ctx.clearRect(0, 0, width, height);

                for (let i = 0; i < particles.length; i++) {
                    let p = particles[i];
                    p.x += p.vx;
                    p.y += p.vy;

                    if (p.x < 0) p.x = width;
                    if (p.x > width) p.x = 0;
                    if (p.y < 0) p.y = height;
                    if (p.y > height) p.y = 0;

                    ctx.fillStyle = `rgba(99, 102, 241, ${p.alpha})`;
                    ctx.beginPath();
                    ctx.arc(p.x, p.y, p.size, 0, Math.PI * 2);
                    ctx.fill();

                    for (let j = i + 1; j < particles.length; j++) {
                        let p2 = particles[j];
                        let dx = p.x - p2.x;
                        let dy = p.y - p2.y;
                        let dist = Math.sqrt(dx * dx + dy * dy);
                        if (dist < 130) {
                            ctx.strokeStyle = `rgba(99, 102, 241, ${(1 - dist / 130) * 0.15})`;
                            ctx.lineWidth = 0.8;
                            ctx.beginPath();
                            ctx.moveTo(p.x, p.y);
                            ctx.lineTo(p2.x, p2.y);
                            ctx.stroke();
                        }
                    }
                }
                requestAnimationFrame(animate);
            }
            animate();
        })();

        // Three.js 3D CAD Preview Modal Implementation
        let cadScene, cadCamera, cadRenderer, cadControls, cadMesh, isRotating = true;
        let animationFrameId;

        function initCadViewer() {
            const container = document.getElementById('cadViewerContainer');
            const canvas = document.getElementById('cadCanvas');
            if (!container || !canvas || cadRenderer) return;

            const rect = container.getBoundingClientRect();
            cadScene = new THREE.Scene();
            cadScene.background = new THREE.Color(0x0a0f1d);

            cadCamera = new THREE.PerspectiveCamera(45, rect.width / rect.height, 0.1, 1000);
            cadCamera.position.set(3, 2.5, 4);

            cadRenderer = new THREE.WebGLRenderer({ canvas: canvas, antialias: true });
            cadRenderer.setSize(rect.width, rect.height);
            cadRenderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));

            // Ambient & Directional Lights
            const ambientLight = new THREE.AmbientLight(0xffffff, 0.7);
            cadScene.add(ambientLight);

            const dirLight1 = new THREE.DirectionalLight(0x06b6d4, 1.2);
            dirLight1.position.set(5, 10, 7);
            cadScene.add(dirLight1);

            const dirLight2 = new THREE.DirectionalLight(0x6366f1, 0.8);
            dirLight2.position.set(-5, -5, -5);
            cadScene.add(dirLight2);

            // Grid helper
            const gridHelper = new THREE.GridHelper(10, 20, 0x6366f1, 0x1e293b);
            gridHelper.position.y = -1.2;
            cadScene.add(gridHelper);

            // Orbit controls
            cadControls = new THREE.OrbitControls(cadCamera, cadRenderer.domElement);
            cadControls.enableDamping = true;
            cadControls.dampingFactor = 0.05;

            // Generate an elegant procedural CAD prototype geometry (Toroidal Geartrain / Engineering Core)
            const geometry = new THREE.TorusKnotGeometry(1, 0.32, 128, 32);
            const material = new THREE.MeshStandardMaterial({
                color: 0x06b6d4,
                metalness: 0.7,
                roughness: 0.25,
                wireframe: false
            });
            cadMesh = new THREE.Mesh(geometry, material);
            cadScene.add(cadMesh);

            function renderCad() {
                animationFrameId = requestAnimationFrame(renderCad);
                if (isRotating && cadMesh) {
                    cadMesh.rotation.y += 0.008;
                    cadMesh.rotation.x += 0.003;
                }
                cadControls.update();
                cadRenderer.render(cadScene, cadCamera);
            }
            renderCad();

            // Handle Resize
            window.addEventListener('resize', () => {
                if (!container || !cadRenderer) return;
                const r = container.getBoundingClientRect();
                cadCamera.aspect = r.width / r.height;
                cadCamera.updateProjectionMatrix();
                cadRenderer.setSize(r.width, r.height);
            });
        }

        // CAD Preview Buttons Click
        document.querySelectorAll('.btn-preview-cad').forEach(btn => {
            btn.addEventListener('click', function() {
                const title = this.getAttribute('data-title') || 'CAD Model Preview';
                const cadPath = this.getAttribute('data-cad') || '#';

                document.getElementById('cadModalTitle').textContent = title + ' — 3D Viewer';
                document.getElementById('btnDownloadCadModal').setAttribute('href', cadPath);

                const modal = new bootstrap.Modal(document.getElementById('cadModal'));
                modal.show();

                setTimeout(() => {
                    initCadViewer();
                    if (cadRenderer) {
                        const container = document.getElementById('cadViewerContainer');
                        const r = container.getBoundingClientRect();
                        cadCamera.aspect = r.width / r.height;
                        cadCamera.updateProjectionMatrix();
                        cadRenderer.setSize(r.width, r.height);
                    }
                }, 250);
            });
        });

        // Toolbar Buttons
        document.getElementById('btnToggleRotate')?.addEventListener('click', function() {
            isRotating = !isRotating;
            this.classList.toggle('active', isRotating);
        });

        document.getElementById('btnToggleWireframe')?.addEventListener('click', function() {
            if (cadMesh) {
                cadMesh.material.wireframe = !cadMesh.material.wireframe;
                this.classList.toggle('active', cadMesh.material.wireframe);
            }
        });

        document.getElementById('btnResetView')?.addEventListener('click', function() {
            if (cadCamera && cadControls) {
                cadCamera.position.set(3, 2.5, 4);
                cadControls.target.set(0, 0, 0);
            }
        });

        // Contact Form Handling (Generates Mailto & Friendly Feedback)
        document.getElementById('contactForm')?.addEventListener('submit', function(e) {
            e.preventDefault();
            const name = document.getElementById('contactName').value;
            const email = document.getElementById('contactEmail').value;
            const subject = document.getElementById('contactSubject').value || 'Portfolio Contact Inquiry';
            const message = document.getElementById('contactMessage').value;

            const targetEmail = '@(string.IsNullOrWhiteSpace(personal.email) ? "contact@balajiportfolio.com" : personal.email)';
            const mailtoUrl = `mailto:${targetEmail}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent("Name: " + name + "\nEmail: " + email + "\n\nMessage:\n" + message)}`;
            
            window.location.href = mailtoUrl;

            alert("Thank you! Your email client has been opened with your inquiry. Looking forward to connecting!");
            this.reset();
        });
    </script>
</body>
</html>
