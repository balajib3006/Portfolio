@{
    ViewData["Title"] = "Publications";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="h4 fw-bold text-dark mb-1"><i class="fa-solid fa-book-bookmark text-danger me-2"></i>Publications</h2>
        <p class="text-muted mb-0">Manage research papers, articles, journal publications, and external links</p>
    </div>
    <button class="btn btn-danger rounded-3 px-4 fw-semibold">
        <i class="fa-solid fa-plus me-2"></i>Add Publication
    </button>
</div>

<div class="card border-0 shadow-sm rounded-4">
    <div class="card-body p-4 text-center py-5">
        <i class="fa-solid fa-newspaper text-muted fs-1 mb-3"></i>
        <h5 class="fw-bold text-dark">No Publications Added Yet</h5>
        <p class="text-muted mb-3">Click the "Add Publication" button above to publish your research & articles.</p>
    </div>
</div>
