@model List<BalajiPortfolio.Models.DTO.PublicationDTO>
@{
    ViewData["Title"] = "Publications";
}

<style>
    .pub-card {
        border: none;
        border-radius: 16px;
        box-shadow: 0 8px 26px rgba(0,0,0,0.06);
        background: #ffffff;
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }
    .pub-card:hover {
        box-shadow: 0 14px 34px rgba(0,0,0,0.12);
        transform: translateY(-2px);
    }
    .publisher-badge {
        background: #eff6ff;
        color: #1e40af;
        font-weight: 600;
        font-size: 0.8rem;
        padding: 4px 12px;
        border-radius: 8px;
        border: 1px solid #bfdbfe;
    }
    .pub-icon {
        width: 50px;
        height: 50px;
        border-radius: 12px;
        background: #eff6ff;
        color: #2563eb;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.5rem;
    }
</style>

<div class="container-fluid px-0">

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-3 mb-4 shadow-sm" role="alert">
            <i class="fa-solid fa-circle-check me-2"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show rounded-3 mb-4 shadow-sm" role="alert">
            <i class="fa-solid fa-circle-exclamation me-2"></i> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Header Section -->
    <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
        <div>
            <h2 class="h3 fw-bold text-dark mb-1"><i class="fa-solid fa-book-bookmark text-primary me-2"></i>Publications</h2>
            <p class="text-muted mb-0">Manage your research papers, articles, journal publications, and reading links</p>
        </div>
        <button type="button" class="btn btn-primary btn-lg rounded-3 shadow-sm px-4 fw-semibold" onclick="openAddPublicationModal()">
            <i class="fa-solid fa-plus me-2"></i>Add Publication
        </button>
    </div>

    <!-- Publications List Cards Grid -->
    @if (Model != null && Model.Count > 0)
    {
        <div class="row g-4">
            @foreach (var item in Model)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="card pub-card h-100 p-4 d-flex flex-column justify-content-between">
                        <div>
                            <div class="d-flex justify-content-between align-items-start mb-3">
                                <div class="pub-icon">
                                    <i class="fa-solid fa-newspaper"></i>
                                </div>
                                @if (!string.IsNullOrEmpty(item.publisher))
                                {
                                    <span class="publisher-badge"><i class="fa-solid fa-building me-1"></i>@item.publisher</span>
                                }
                            </div>

                            <h5 class="fw-bold text-dark mb-2">@item.title</h5>

                            @if (!string.IsNullOrEmpty(item.publicationDate))
                            {
                                <p class="text-muted small mb-3"><i class="fa-regular fa-calendar-days me-1"></i>Published: @item.publicationDate</p>
                            }

                            @if (!string.IsNullOrEmpty(item.publicationLink))
                            {
                                <div class="mb-3">
                                    <a href="@item.publicationLink" target="_blank" class="btn btn-sm btn-outline-primary rounded-2">
                                        <i class="fa-solid fa-arrow-up-right-from-square me-1"></i>Read Publication
                                    </a>
                                </div>
                            }
                        </div>

                        <div class="d-flex justify-content-end gap-2 pt-3 border-top mt-3">
                            <button type="button" class="btn btn-outline-primary btn-sm rounded-2" onclick='editPublication(@Html.Raw(System.Text.Json.JsonSerializer.Serialize(item)))'>
                                <i class="fa-solid fa-pen me-1"></i>Edit
                            </button>
                            <form asp-controller="Publication" asp-action="DeletePublication" method="post" class="d-inline" onsubmit="return confirm('Are you sure you want to delete this publication?');">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@item.mstPublicationId" />
                                <button type="submit" class="btn btn-outline-danger btn-sm rounded-2">
                                    <i class="fa-solid fa-trash me-1"></i>Delete
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="card pub-card p-5 text-center my-4">
            <i class="fa-solid fa-book-bookmark text-muted fs-1 mb-3"></i>
            <h5 class="fw-bold text-dark">No Publications Added Yet</h5>
            <p class="text-muted mb-4">Click the <strong>"Add Publication"</strong> button above to list your articles & research papers.</p>
            <div>
                <button type="button" class="btn btn-primary rounded-3 px-4 fw-semibold" onclick="openAddPublicationModal()">
                    <i class="fa-solid fa-plus me-2"></i>Add Publication
                </button>
            </div>
        </div>
    }

</div>

<!-- ================================================================= -->
<!-- MODAL: Add / Edit Publication Form -->
<!-- ================================================================= -->
<div class="modal fade" id="modalPublication" tabindex="-1" aria-labelledby="modalPublicationLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content border-0 shadow-lg rounded-4">
            <div class="modal-header bg-primary text-white rounded-top-4">
                <h5 class="modal-title fw-bold" id="modalPublicationLabel">
                    <i class="fa-solid fa-book-bookmark me-2"></i><span id="modalPubTitleText">Add Publication</span>
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-controller="Publication" asp-action="SavePublication" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="mstPublicationId" id="pubId" value="0" />

                <div class="modal-body p-4">
                    <div class="row g-3">
                        <div class="col-12">
                            <label class="form-label fw-semibold">Title <span class="text-danger">*</span></label>
                            <input type="text" name="title" id="pubTitle" class="form-control" placeholder="Enter paper / article title" required />
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Publisher</label>
                            <input type="text" name="publisher" id="pubPublisher" class="form-control" placeholder="e.g. IEEE, Springer, Medium, ArXiv" />
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Date / Year</label>
                            <input type="text" name="publicationDate" id="pubDate" class="form-control" placeholder="e.g. 2024 / May 2024" />
                        </div>

                        <div class="col-12">
                            <label class="form-label fw-semibold">Publication Link (URL)</label>
                            <input type="url" name="publicationLink" id="pubLink" class="form-control" placeholder="https://doi.org/... or article link" />
                        </div>
                    </div>
                </div>

                <div class="modal-footer bg-light rounded-bottom-4">
                    <button type="button" class="btn btn-secondary px-4" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary px-4 fw-semibold">Save Publication</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let modalPublication;

        document.addEventListener('DOMContentLoaded', function () {
            modalPublication = new bootstrap.Modal(document.getElementById('modalPublication'));
        });

        function openAddPublicationModal() {
            document.getElementById('modalPubTitleText').innerText = "Add Publication";
            document.getElementById('pubId').value = 0;
            document.getElementById('pubTitle').value = "";
            document.getElementById('pubPublisher').value = "";
            document.getElementById('pubDate').value = "";
            document.getElementById('pubLink').value = "";

            modalPublication.show();
        }

        function editPublication(data) {
            document.getElementById('modalPubTitleText').innerText = "Edit Publication";
            document.getElementById('pubId').value = data.mstPublicationId;
            document.getElementById('pubTitle').value = data.title || "";
            document.getElementById('pubPublisher').value = data.publisher || "";
            document.getElementById('pubDate').value = data.publicationDate || "";
            document.getElementById('pubLink').value = data.publicationLink || "";

            modalPublication.show();
        }
    </script>
}
