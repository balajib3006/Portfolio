@{
    ViewData["Title"] = "Messages & Contact Inquiries";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="h4 fw-bold text-dark mb-1"><i class="fa-solid fa-envelope text-primary me-2"></i>Contact Messages</h2>
        <p class="text-muted mb-0">View and respond to inquiries submitted through your portfolio website</p>
    </div>
</div>

<div class="card border-0 shadow-sm rounded-4">
    <div class="card-body p-4 text-center py-5">
        <i class="fa-solid fa-comments text-muted fs-1 mb-3"></i>
        <h5 class="fw-bold text-dark">No Messages Received Yet</h5>
        <p class="text-muted mb-0">Contact form submissions from visitors will appear here.</p>
    </div>
</div>
